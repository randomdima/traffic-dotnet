{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build release",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/traffic-dotnet.csproj",
        "-c",
        "Release",
        "-consoleLoggerParameters:NoSummary;ForceNoAlign"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      // The configuration a breakpoint is worth setting in: optimisations off, and the
      // managed->native crossing counter compiled in rather than out.
      "label": "build debug",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/traffic-dotnet.csproj",
        "-c",
        "Debug",
        "-consoleLoggerParameters:NoSummary;ForceNoAlign"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      // Publishes the browser head ahead-of-time compiled and serves it from
      // bin/web/Release/net11.0/publish/wwwroot.
      //
      // **It costs about ten minutes, and the alternative costs more.** `qq web --debug` lays the same
      // tree in ten seconds, but the ahead-of-time step happens on publish and never on build, so what
      // it lays is the IL interpreter: measured on this machine, the fetch, the unpack, the decode and
      // the laying are 1.8 s either way and then standing one town up is twenty seconds against this
      // page's tenth of one. A page nobody can bear to open is not a shorter loop.
      //
      // --timeout=0 lifts qq's own ten-second cap, which a server is meant to outlive. The task goes
      // on serving after the debug session ends; stop it from the terminal panel, or answer
      // "Restart" when the next launch finds it still running.
      "label": "serve web (release)",
      "type": "process",
      "command": "${userHome}/.local/bin/qq",
      "args": ["web", "--serve", "--timeout=0"],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      // The launch waits on the "serving …" line, which is why web.py flushes it.
      "problemMatcher": {
        "owner": "web",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+),(\\d+)\\): (error|warning) (\\w+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^=== ",
          "endsPattern": "^serving "
        }
      }
    },
    {
      // Publishes the browser head and stops — the page `serve Saltbay` hands its players (MP-11). The same ten
      // minutes as above, and only needed when the page's own code has changed since the last publish.
      "label": "publish web (release)",
      "type": "process",
      "command": "${userHome}/.local/bin/qq",
      "args": ["web", "--timeout=0"],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      // Saltbay served to players with no window (MP-1…11): open http://localhost:8740/ in a browser and the page
      // the server hands out joins it. The page is the last `publish web (release)`; with none published the server
      // says so and takes players from a page served elsewhere. Stop it with Ctrl+C in its terminal.
      // The Cloudflare tunnel below is started first, so the same page is reachable from outside this machine.
      "label": "serve Saltbay (multiplayer)",
      "dependsOn": ["tunnel serve (cloudflare)"],
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/traffic-dotnet.csproj",
        "-c",
        "Release",
        "--",
        "--serve",
        "--map",
        "Saltbay"
      ],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      // Ready once the town is laid and the port is open: ServeRun's "serving …" line.
      "problemMatcher": {
        "owner": "serve",
        "fileLocation": ["absolute"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+),(\\d+)\\): (error|warning) (\\w+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^laying ",
          "endsPattern": "^serving "
        }
      }
    },
    {
      // A Cloudflare quick tunnel to the multiplayer server, run in the `cf` toolbox, which holds cloudflared. Its
      // public https://….trycloudflare.com address is new every start and printed in this terminal; anybody holding
      // it reaches the server, so stop it with Ctrl+C when nobody is playing. 8740 is MultiplayerFigures.Port.
      "label": "tunnel serve (cloudflare)",
      "type": "process",
      "command": "toolbox",
      "args": ["run", "-c", "cf", "cloudflared", "tunnel", "--no-autoupdate", "--url", "http://localhost:8740"],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      // Ready once the tunnel has its address; nothing it prints is a problem in the code.
      "problemMatcher": {
        "owner": "tunnel",
        "pattern": { "regexp": "^\\b\\B$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Thank you for trying Cloudflare Tunnel",
          "endsPattern": "trycloudflare\\.com"
        }
      }
    }
  ]
}
