{
  "version": "0.2.0",
  "configurations": [
    {
      // The desktop head, Release and no debugger attached: the tiered-JIT steady state the engine is measured in.
      // No --map: a run handed none opens on the start menu over the idle ring (GEN-1b). The world is stepped on the
      // device and the actors on the CPU, the default; --managed-world steps it all on the CPU.
      // The display is named because no desktop will say which screen is in front of the person.
      "name": "Desktop",
      "type": "coreclr",
      "request": "launch",
      "noDebug": true,
      "preLaunchTask": "build release",
      "program": "${workspaceFolder}/bin/Release/net11.0/traffic-dotnet",
      "args": ["--display", "HDMI-1"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      // The browser head, on this machine. The task publishes the page ahead-of-time compiled and serves it on 8730;
      // this opens a Chromium of its own at it, and the page's console arrives in the Debug Console.
      //
      // **The published page and never the Debug one**, whatever the ten minutes cost: a built page is the IL
      // interpreter, which stands a town up many times slower. The page steps its world on its device by default, as
      // the desktop does; the query string is the command line (WEB-5): ?map=Odesa, ?map=Test&ui=frame, ?managed-world.
      //
      // **Both WebGPU flags are needed on a desktop Linux**: drop either and the page comes back with no adapter. The
      // rest are the dialogs a browser nobody is sitting at would otherwise wait on — the set `qq web` drives. A profile
      // of its own, so a `qq web --shot` run and this one are never two browsers on one profile directory.
      "name": "Web",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "serve web (release)",
      "url": "http://localhost:8730/",
      "webRoot": "${workspaceFolder}/src/app/web/wwwroot",
      "runtimeExecutable": "/usr/bin/chromium-browser",
      "runtimeArgs": [
        "--enable-unsafe-webgpu",
        "--enable-features=Vulkan",
        "--test-type",
        "--no-first-run",
        "--no-default-browser-check",
        "--disable-fre",
        "--disable-search-engine-choice-screen"
      ],
      "userDataDir": "${workspaceFolder}/.tmp/web-profile-code"
    }
  ]
}
