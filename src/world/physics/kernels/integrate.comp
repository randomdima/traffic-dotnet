#version 460

// The solver's last stage on the device: every moving body taken to where its own motion and the push it was given
// leave it, the push discarded, its rotation and bounds read again (PhysicsWorld.Integrate). One thread a body of the
// moving roster; nothing here reads another body, so the order bodies are taken in changes nothing.
//
// Every figure the CPU's step also makes is `precise`: left alone, the compiler fuses a*b+c into one fma, which rounds
// once where the CPU rounds twice, and a bound lands a float away from the host's. sin and cos are the device's own
// and are not the host's to the bit.

layout(local_size_x = 64) in;

layout(push_constant) uniform Step
{
    float dtS;
    uint movingCount;
    uint filedFrozenBit;
};

layout(std430, binding = 0) readonly buffer Moving { int moving[]; };
layout(std430, binding = 1) buffer Position { vec2 positionM[]; };
layout(std430, binding = 2) buffer HeadingB { float headingRad[]; };
layout(std430, binding = 3) buffer Rotation { vec2 rotation[]; };
layout(std430, binding = 4) readonly buffer Velocity { vec2 velocityMps[]; };
layout(std430, binding = 5) readonly buffer YawRate { float yawRateRadPerS[]; };
layout(std430, binding = 6) readonly buffer PushB { vec2 pushMps[]; };
layout(std430, binding = 7) readonly buffer PushYaw { float pushYawRadPerS[]; };
layout(std430, binding = 8) readonly buffer Extent { vec2 extentM[]; };
layout(std430, binding = 9) readonly buffer Radius { float cornerRadiusM[]; };
layout(std430, binding = 10) buffer Least { vec2 leastM[]; };
layout(std430, binding = 11) buffer Most { vec2 mostM[]; };
layout(std430, binding = 12) buffer Flags { uint flags[]; };

const float Pi = 3.14159265358979;
const float Turn = 2.0 * Pi;

// The half-open turn the rest of the engine reads a heading in (PhysicsWorld.Wrap).
float wrapped(float rad)
{
    while (rad > Pi) rad -= Turn;
    while (rad <= -Pi) rad += Turn;
    return rad;
}

void main()
{
    uint slot = gl_GlobalInvocationID.x;
    if (slot >= movingCount) return;

    int body = moving[slot];
    vec2 travelMps = velocityMps[body] + pushMps[body];
    float turnRadPerS = yawRateRadPerS[body] + pushYawRadPerS[body];
    if (travelMps != vec2(0.0) || turnRadPerS != 0.0) flags[body] &= ~filedFrozenBit;

    // precise: unfused, as the CPU's own arithmetic is, so a body lands on the same float either side.
    precise vec2 position = positionM[body] + travelMps * dtS;
    positionM[body] = position;

    precise float turned = headingRad[body] + turnRadPerS * dtS;
    float heading = wrapped(turned);
    headingRad[body] = heading;
    vec2 unit = vec2(cos(heading), sin(heading));
    rotation[body] = unit;

    // Shape.HalfBoundsM: the box's reach along each world axis at this rotation, and its corner radius past that.
    vec2 extent = extentM[body];
    float c = abs(unit.x);
    float s = abs(unit.y);
    precise vec2 half_ = vec2(extent.x * c + extent.y * s, extent.x * s + extent.y * c) + vec2(cornerRadiusM[body]);
    leastM[body] = position - half_;
    mostM[body] = position + half_;
}
