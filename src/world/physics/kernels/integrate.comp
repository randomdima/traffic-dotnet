#version 460
#extension GL_GOOGLE_include_directive : require

// The solver's last stage on the device: every moving body taken to where its own motion and the push it was given
// leave it, its rotation and bounds read again (PhysicsWorld.Integrate). One thread a body of the moving roster;
// nothing here reads another body, so the order bodies are taken in changes nothing.
//
// Every figure the CPU's step also makes is `precise`: left alone, the compiler fuses a*b+c into one fma, which rounds
// once where the CPU rounds twice, and a bound lands a float away from the host's. sin and cos are trig.glsl's, within a
// float or two of the host's on every driver.

layout(local_size_x = 64) in;

#include "step.glsl"
#include "core/geometry/kernels/trig.glsl"

layout(std430, binding = 0) readonly buffer Owners { int owners[]; };
layout(std430, binding = 1) buffer Pose { vec4 pose[]; };
layout(std430, binding = 2) buffer HeadingB { float headingRad[]; };
layout(std430, binding = 3) readonly buffer Motion { vec4 motion[]; };
layout(std430, binding = 4) readonly buffer PushB { vec4 push_[]; };
layout(std430, binding = 5) readonly buffer ShapeB { vec4 shape[]; };
layout(std430, binding = 6) writeonly buffer Bounds { vec4 bounds[]; };
layout(std430, binding = 7) buffer Filter { uvec4 filter_[]; };

const float Pi = 3.14159265358979;
const float Turn = 2.0 * Pi;

// The half-open turn the rest of the engine reads a heading in (PhysicsWorld.Wrap).
float wrapped(float rad)
{
    while (rad > Pi) rad -= Turn;
    while (rad <= -Pi) rad += Turn;
    return rad;
}

void main()
{
    uint slot = gl_GlobalInvocationID.x;
    if (slot >= rosterCount) return;

    int body = owners[slot];
    vec4 m = motion[body];
    vec4 p = push_[body];
    precise vec2 travelMps = m.xy + p.xy;
    precise float turnRadPerS = m.z + p.z;
    if (travelMps != vec2(0.0) || turnRadPerS != 0.0) filter_[body].x &= ~filedFrozenBit;

    precise vec2 position = pose[body].xy + travelMps * dtS;
    precise float turned = headingRad[body] + turnRadPerS * dtS;
    float heading = wrapped(turned);
    headingRad[body] = heading;
    vec2 unit = trigUnit(heading);
    pose[body] = vec4(position, unit);

    // Shape.HalfBoundsM: the box's reach along each world axis at this rotation, and its corner radius past that.
    vec4 s = shape[body];
    float c = abs(unit.x);
    float n = abs(unit.y);
    precise vec2 half_ = vec2(s.x * c + s.y * n, s.x * n + s.y * c) + vec2(s.z);
    bounds[body] = vec4(position - half_, position + half_);
}
