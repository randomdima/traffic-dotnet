#version 460
#extension GL_GOOGLE_include_directive : require

// The indirect dispatches a step's later passes are sized by, written from the totals the scans left: one thread,
// so the recording never has to know how many candidates or contacts a step will find.

layout(local_size_x = 1) in;

#include "step.glsl"

layout(std430, binding = 0) buffer Totals { uint totals[]; };

void main()
{
    uint candidates = min(totals[CandidateTotalAt], capacity);
    totals[CandidateGroupsAt] = (candidates + 63u) / 64u;
    totals[CandidateGroupsAt + 1u] = 1u;
    totals[CandidateGroupsAt + 2u] = 1u;

    uint contacts = min(totals[ContactTotalAt], capacity);
    totals[ContactGroupsAt] = (contacts + 63u) / 64u;
    totals[ContactGroupsAt + 1u] = 1u;
    totals[ContactGroupsAt + 2u] = 1u;
}
