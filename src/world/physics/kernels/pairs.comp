#version 460
#extension GL_GOOGLE_include_directive : require

// Every pair worth a manifold that an awake body owns (PhysicsWorld.FindContacts / Gather), one thread a roster body
// (gather.glsl). Which bodies are awake is their state as the step began (owned.glsl): the frozen ones a manifold wakes
// are woken.comp's, which gathers what they own.
//
// A pair is filed in the run of its lower body, the furniture always second, so the whole list reads by (first,
// second) — the order the CPU puts its contacts in (PhysicsWorld.OrderContacts) — with no sort but each run's own:
// - an awake body takes every moving body above it that it meets, awake or frozen, and the furniture it meets;
// - a frozen body takes only the awake bodies above it, which own the pair on the CPU — so it walks the moving grid,
//   where a cell holds a handful, and never the furniture's, which is what freezing saves (SOL-37);
// - two frozen bodies make no pair here.
//
// Mode 0 counts each body's candidates; mode 1 writes them at the run the scan of those counts gave it, ordered by
// the other body's index.
//
// A body out of the world owns nothing: the roster may name every moving body whether or not it is in the world, so
// that a body going into a container changes no roster (DeviceSolver.LayEveryOwner).

layout(local_size_x = 64) in;

#include "step.glsl"
#include "owned.glsl"

layout(std430, binding = 0) readonly buffer Owners { int owners[]; };
layout(std430, binding = 1) readonly buffer Bounds { vec4 bounds[]; };
layout(std430, binding = 2) readonly buffer Filter { uint filter_[]; };
layout(std430, binding = 3) readonly buffer MovingStarts { uint movingStarts[]; };
layout(std430, binding = 4) readonly buffer MovingItems { uvec2 movingItems[]; };
layout(std430, binding = 5) readonly buffer StaticCounts { uint staticCounts[]; };
layout(std430, binding = 6) readonly buffer StaticStarts { uint staticStarts[]; };
layout(std430, binding = 7) readonly buffer StaticItems { int staticItems[]; };
layout(std430, binding = 8) buffer CandidateCounts { uint candidateCounts[]; };
layout(std430, binding = 9) readonly buffer CandidateStarts { uint candidateStarts[]; };
layout(std430, binding = 10) buffer Candidates { uvec2 candidates[]; };
layout(std430, binding = 11) buffer Totals { uint totals[]; };
layout(std430, binding = 12) readonly buffer State { uint state[]; };

#include "gather.glsl"

uint found;
uint writeFrom;
bool ownerAwake;

bool takes(int owner, int other) { return other > owner && (ownerAwake || awakeAtStart(state[other])); }

void keep(int owner, int other)
{
    if (mode == 1u)
    {
        uint at = writeFrom + found;
        if (at < capacity) candidates[at] = uvec2(uint(owner), uint(other));
    }

    found++;
}

void main()
{
    uint slot = gl_GlobalInvocationID.x;
    if (slot >= rosterCount) return;

    int owner = owners[slot];
    if ((filter_[owner] & enabledBit) == 0u)
    {
        if (mode == 0u) candidateCounts[slot] = 0u;
        return;
    }

    found = 0u;
    writeFrom = mode == 1u ? candidateStarts[slot] : 0u;
    ownerAwake = awakeAtStart(state[owner]);
    gather(owner, ownerAwake);

    if (mode == 0u)
    {
        candidateCounts[slot] = found;
        return;
    }

    // The owner's own run put in the other body's order: a handful, so an insertion sort (PhysicsWorld.Order).
    uint count = min(found, writeFrom < capacity ? capacity - writeFrom : 0u);
    for (uint at = 1u; at < count; at++)
    {
        uvec2 pair = candidates[writeFrom + at];
        uint into = at;
        while (into > 0u && candidates[writeFrom + into - 1u].y > pair.y)
        {
            candidates[writeFrom + into] = candidates[writeFrom + into - 1u];
            into--;
        }

        candidates[writeFrom + into] = pair;
    }

    if (writeFrom + found > capacity) atomicMax(totals[OverflowAt], writeFrom + found);
}
