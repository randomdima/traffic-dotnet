#version 460
#extension GL_GOOGLE_include_directive : require

// What settle.comp's parallel unsettling over the contacts passed along (settle.glsl), passed on until no contact passes
// anything — in one workgroup, whose barrier ends each pass rather than a queue's. Nothing to do where that pass
// changed nothing, which is most steps.

layout(local_size_x = 1024) in;

#include "settle.glsl"

const uint Threads = 1024u;

shared bool changed;

// The step's unsettled count, as thread 0 read it, for every thread to read as one figure.
shared uint unsettled;

void sync()
{
    memoryBarrierBuffer();
    memoryBarrierShared();
    barrier();
}

// Shared figures every thread reads alike, each read right after a sync; a page's WGSL takes each load as a
// workgroupUniformLoad (solve.comp, town.js).
uint workgroupUniformUnsettled() { return unsettled; }

bool workgroupUniformChanged() { return changed; }

void main()
{
    uint thread = gl_LocalInvocationID.x;
    if (thread == 0u) unsettled = totals[UnsettledAt];
    sync();
    if (workgroupUniformUnsettled() == 0u) return;

    uint contacts = contactCount();
    bool passing;
    do
    {
        sync();
        if (thread == 0u) changed = false;
        sync();
        for (uint at = thread; at < contacts; at += Threads)
        {
            if (unsettle(at)) changed = true;
        }

        sync();
        passing = workgroupUniformChanged();
    }
    while (passing);
}
