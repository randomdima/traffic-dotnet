#version 460
#extension GL_GOOGLE_include_directive : require

// Which pairs began touching in the step (PhysicsWorld.ReportBegun, SOL-6, SOL-37c), after settle.comp has frozen what
// settled, and what is touching from here on — one sorted list of pairs (lower body, then higher, the furniture second),
// searched by the next step as what was touching before it.
//
// Every contact has a body the step owned (owned.glsl), so a contact whose pair was not touching began. A pair touching
// before that the step did not find is held where neither of its bodies asked what it touches — owned, or out of the
// world — since then neither has moved since the step that last asked, and dropped otherwise (SOL-37c). What is touching
// from here on is the contacts and the held pairs, merged: each placed by how many of the other list come before it.
//
// One thread a contact; and the pairs touching before, a block of 64 a workgroup, each workgroup taking every block a
// dispatch's worth of workgroups apart. Mode 0 counts what began, a workgroup at a time, and what is held, a block at a
// time — begun counts first, then held, in one run — and the scan of that run says where each workgroup's begun go and how
// many held pairs come before each block. Mode 1 lists the begun there, in the contacts' order (DeviceSolver.Begun), and
// writes the merged list.

layout(local_size_x = 64) in;

#include "step.glsl"
#include "owned.glsl"

layout(std430, binding = 0) readonly buffer Contact { uvec4 contact[]; };
layout(std430, binding = 1) readonly buffer ContactNormal { vec4 contactNormal[]; };
layout(std430, binding = 2) readonly buffer Totals { uint totals[]; };
layout(std430, binding = 3) readonly buffer State { uint state[]; };
layout(std430, binding = 4) readonly buffer Was { uvec2 was[]; };
layout(std430, binding = 5) readonly buffer WasCount { uint wasCount; };
layout(std430, binding = 6) writeonly buffer Now { uvec2 now[]; };
layout(std430, binding = 7) writeonly buffer NowCount { uint nowCount; };

// The begun counted a workgroup of contacts at a time, then the held a block at a time — scanned between the modes.
layout(std430, binding = 8) buffer Counted { uint counted[]; };

// Each begun from 0 on, as many as there is room for (begunRoom): its pair, its normal, and how fast the two closed along
// it on the motion they brought into the tick (DeviceSolver.BegunRow, ContactArbiter) — the furniture's none.
struct BegunRow
{
    uvec2 pair;
    vec2 normal;
    float closingMps;
    float pad0;
    float pad1;
    float pad2;
};

layout(std430, binding = 9) writeonly buffer Begun { BegunRow begun[]; };
layout(std430, binding = 10) readonly buffer MotionIntoTick { vec4 motionIntoTick[]; };

// The step's totals handed back by mode 1's first thread, the last of the step to read them — straight into memory the host
// reads, so no copy waits behind a barrier for them (DeviceSolver.TotalsRead) — with the begun counted apart from the held.
// The scan of the contacts always gives this pass a workgroup.
layout(std430, binding = 11) writeonly buffer TotalsOut { uint totalsOut[]; };

// DeviceSolver.Totals.
const uint BegunCountAt = 20u;

shared uint scanned[64];

bool before(uvec2 a, uvec2 b) { return a.x < b.x || (a.x == b.x && a.y < b.y); }

// How many pairs touching before come before this one.
uint wasBefore(uvec2 pair)
{
    uint low = 0u;
    uint high = wasCount;
    while (low < high)
    {
        uint middle = (low + high) / 2u;
        if (before(was[middle], pair)) low = middle + 1u;
        else high = middle;
    }

    return low;
}

// How many of the step's contacts come before this pair.
uint contactsBefore(uvec2 pair, uint contacts)
{
    uint low = 0u;
    uint high = contacts;
    while (low < high)
    {
        uint middle = (low + high) / 2u;
        if (before(contact[middle].xy, pair)) low = middle + 1u;
        else high = middle;
    }

    return low;
}

bool wasTouching(uvec2 pair)
{
    uint at = wasBefore(pair);
    return at < wasCount && was[at] == pair;
}

bool asked(uint body) { return (state[body] & (Owned | Left)) != 0u; }

bool held(uint at) { return at < wasCount && !asked(was[at].x) && !asked(was[at].y); }

// The workgroup's flags summed up to each thread's own, inclusive. Every thread of the workgroup calls it.
uint prefix(bool flag)
{
    uint thread = gl_LocalInvocationID.x;
    scanned[thread] = flag ? 1u : 0u;
    barrier();
    for (uint offset = 1u; offset < 64u; offset <<= 1u)
    {
        uint earlier = thread >= offset ? scanned[thread - offset] : 0u;
        barrier();
        scanned[thread] += earlier;
        barrier();
    }

    uint mine = scanned[thread];
    barrier();
    return mine;
}

// Which workgroup this is and how many there are, as its first thread read them: naga hands a page's WGSL the built-ins
// through variables WGSL cannot tell are every thread's alike, so they are shared and read as workgroupUniformLoads
// (solve.comp, town.js).
shared uint workgroupAt;
shared uint workgroupCount;

uint workgroupUniformAt() { return workgroupAt; }

uint workgroupUniformCount() { return workgroupCount; }

void main()
{
    uint at = gl_GlobalInvocationID.x;
    uint thread = gl_LocalInvocationID.x;
    if (thread == 0u)
    {
        workgroupAt = gl_WorkGroupID.x;
        workgroupCount = gl_NumWorkGroups.x;
    }

    barrier();
    uint group = workgroupUniformAt();
    uint groups = workgroupUniformCount();
    uint contacts = min(totals[ContactTotalAt], contactCapacity);

    // Where the held blocks' counts start: past one count for each workgroup the contacts can take.
    uint heldFrom = (contactCapacity + 63u) / 64u;

    bool began = at < contacts && !wasTouching(contact[at].xy);
    uint begunUpTo = prefix(began);
    if (mode == 0u)
    {
        if (thread == 63u) counted[group] = begunUpTo;
        for (uint block = group; block * 64u < wasCount; block += groups)
        {
            uint heldUpTo = prefix(held(block * 64u + thread));
            if (thread == 63u) counted[heldFrom + block] = heldUpTo;
        }

        return;
    }

    uint begunTotal = counted[heldFrom];
    uint heldTotal = totals[BegunCountAt] - begunTotal;
    uint room = contactCapacity;
    if (at == 0u)
    {
        for (uint total = 0u; total < uint(totalsOut.length()); total++) totalsOut[total] = totals[total];
        totalsOut[BegunCountAt] = begunTotal;
        if (contacts + heldTotal > room) totalsOut[OverflowAt] = 0xFFFFFFFFu;
        nowCount = min(contacts + heldTotal, room);
    }

    if (at < contacts)
    {
        uvec2 pair = contact[at].xy;
        uint below = wasBefore(pair);
        uint block = below / 64u;
        uint heldBelow = block * 64u < wasCount ? counted[heldFrom + block] - begunTotal : heldTotal;
        for (uint other = block * 64u; other < below; other++)
        {
            if (held(other)) heldBelow++;
        }

        if (at + heldBelow < room) now[at + heldBelow] = pair;

        uint into = counted[group] + begunUpTo - 1u;
        if (began && into < begunRoom)
        {
            vec2 normal = contactNormal[at].xy;
            precise vec2 apartMps = motionIntoTick[pair.x].xy - motionIntoTick[pair.y].xy;
            precise float closingMps = apartMps.x * normal.x + apartMps.y * normal.y;
            begun[into] = BegunRow(pair, normal, closingMps, 0.0, 0.0, 0.0);
        }
    }

    for (uint block = group; block * 64u < wasCount; block += groups)
    {
        uint slot = block * 64u + thread;
        bool kept = held(slot);
        uint heldUpTo = prefix(kept);

        // Not `continue`: WGSL takes a thread that skips the rest of an iteration as leaving the next one's barriers
        // out of step.
        if (kept)
        {
            uint rank = counted[heldFrom + block] - begunTotal + heldUpTo - 1u;
            uint into = rank + contactsBefore(was[slot], contacts);
            if (into < room) now[into] = was[slot];
        }
    }
}
