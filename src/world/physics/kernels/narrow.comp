#version 460
#extension GL_GOOGLE_include_directive : require

// Every candidate's manifold (PhysicsWorld.Narrow), one thread a pair: the first body and the second, which is lower
// index first and the furniture second. What met is flagged for the compaction that follows, so the contacts keep the
// candidates' order.
//
// A frozen body a manifold meets is woken into the step (PhysicsWorld.WakeInStep, SOL-37a): owned from here, its
// overlap cleared for its contacts to find again, and listed for woken.comp to gather what it owns in turn. Every pair
// here has an awake body, so whichever of the two is frozen is the one woken.

layout(local_size_x = 64) in;

#include "step.glsl"
#include "shape.glsl"
#include "owned.glsl"

// Where the step's totals keep how many bodies it has woken (DeviceSolver.Totals).
const uint WokenAt = 16u;

layout(std430, binding = 0) readonly buffer Candidates { uvec2 candidates[]; };
layout(std430, binding = 1) readonly buffer Pose { vec4 pose[]; };
layout(std430, binding = 2) readonly buffer ShapeB { vec4 shape[]; };
layout(std430, binding = 3) writeonly buffer Met { uint met[]; };
layout(std430, binding = 4) writeonly buffer Flags { uint flagged[]; };
// A candidate's manifold in two rows (DeviceSolver.Manifolds): its normal and separations, then its points.
layout(std430, binding = 5) writeonly buffer Manifolds { vec4 manifolds[]; };
layout(std430, binding = 6) buffer Totals { uint totals[]; };
layout(std430, binding = 7) buffer State { uint state[]; };
layout(std430, binding = 8) writeonly buffer Overlap { uint overlap[]; };
layout(std430, binding = 9) writeonly buffer WokenList { uint woken[]; };

void wake(uint body)
{
    if (!stillFrozen(state[body])) return;
    if ((atomicOr(state[body], Owned | Woken) & Owned) != 0u) return;

    overlap[body] = 0u;
    woken[atomicAdd(totals[WokenAt], 1u)] = body;
}

void main()
{
    uint at = gl_GlobalInvocationID.x;
    if (at >= min(totals[CandidateTotalAt], capacity)) return;

    uvec2 pair = candidates[at];
    vec4 a = pose[pair.x];
    vec4 b = pose[pair.y];
    vec4 shapeA = shape[pair.x];
    vec4 shapeB = shape[pair.y];

    Manifold m;
    bool touching = shapeCollide(a.xy, a.zw, shapeA.xy, shapeA.z, b.xy, b.zw, shapeB.xy, shapeB.z, speculativeM, m);
    met[at] = touching ? uint(m.pointCount) : 0u;
    flagged[at] = touching ? 1u : 0u;
    manifolds[2u * at] = vec4(m.normal, m.separation0, m.separation1);
    manifolds[2u * at + 1u] = vec4(m.point0, m.point1);
    if (!touching) return;

    wake(pair.x);
    wake(pair.y);
}
