#version 460
#extension GL_GOOGLE_include_directive : require

// The arms and effective masses every contact point is solved against, once a step, with the impulses started from
// nothing (PhysicsWorld.Prepare). Two slots a contact, as on the CPU: point p of contact c at 2c + p.

layout(local_size_x = 64) in;

#include "step.glsl"
#include "shape.glsl"

layout(std430, binding = 0) readonly buffer Contact { uvec4 contact[]; };
layout(std430, binding = 1) readonly buffer ContactNormal { vec4 contactNormal[]; };
layout(std430, binding = 2) readonly buffer ContactPoints { vec4 contactPoints[]; };
layout(std430, binding = 3) readonly buffer Pose { vec4 pose[]; };
layout(std430, binding = 4) readonly buffer Mass { vec2 mass[]; };
layout(std430, binding = 5) writeonly buffer Arms { vec4 arms[]; };
layout(std430, binding = 6) writeonly buffer PointMass { vec2 pointMass[]; };
layout(std430, binding = 7) writeonly buffer Impulses { vec4 impulses[]; };
layout(std430, binding = 8) readonly buffer Totals { uint totals[]; };

float effectiveMass(vec2 massA, vec2 massB, vec2 armA, vec2 armB, vec2 direction)
{
    float turnA = shapeCross(armA, direction);
    float turnB = shapeCross(armB, direction);
    precise float resistance = massA.x + massB.x + massA.y * turnA * turnA + massB.y * turnB * turnB;
    return resistance > 0.0 ? roundedQuotient(1.0, resistance) : 0.0;
}

void main()
{
    uint at = gl_GlobalInvocationID.x;
    if (at >= min(totals[ContactTotalAt], capacity)) return;

    uvec4 c = contact[at];
    vec2 normal = contactNormal[at].xy;
    vec2 tangent = shapeLeftPerpendicular(normal);
    vec4 points = contactPoints[at];
    vec2 positionA = pose[c.x].xy;
    vec2 positionB = pose[c.y].xy;
    vec2 massA = mass[c.x];
    vec2 massB = mass[c.y];

    for (uint point = 0u; point < c.z; point++)
    {
        vec2 pointM = point == 0u ? points.xy : points.zw;
        precise vec2 armA = pointM - positionA;
        precise vec2 armB = pointM - positionB;
        uint slot = at * 2u + point;
        arms[slot] = vec4(armA, armB);
        pointMass[slot] = vec2(effectiveMass(massA, massB, armA, armB, normal), effectiveMass(massA, massB, armA, armB, tangent));
        impulses[slot] = vec4(0.0);
    }
}
