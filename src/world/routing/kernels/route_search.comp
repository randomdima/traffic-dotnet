#version 460
#extension GL_GOOGLE_include_directive : require

// The route service (app/devicetick/DeviceRoutes): one request slot a workgroup. A slot that is pending is searched to
// completion as RouteSearch.Plan searches it, over its own network and its own scratch; its answer is written, what the
// slot carries to its next search kept, and the slot marked done. Any other slot is left as it stands.

#include "world/routing/kernels/route_search.glsl"

// A slot a workgroup, searched by its first lane alone: a wave's lanes go in step, so a wave of searches takes as long as
// every path any of them took. The second lane only keeps the slot a value that differs lane to lane — in a workgroup of
// one, lavapipe takes every value as uniform, and its loads then read a step past the end of a loop's table.
layout(local_size_x = 2) in;

void main()
{
    if (gl_LocalInvocationIndex != 0u) return;

    uint slot = gl_GlobalInvocationID.x / gl_WorkGroupSize.x;
    if (slot >= routes_Figures.slots || routes_Request(slot).state != RouteSlotPending) return;

    RouteRequest request = routes_Request(slot);
    RouteSearch search = routeSearchFor(slot, request.network);
    RouteSurchargeTable surcharges = routes_Surcharges(request.network);
    RouteMarks marks = RouteMarks(surcharges, surcharges.count, request.nowS);
    RouteClosedLinks closed = RouteClosedLinks(TOWN(Uints, routes_Table(request.network, RouteClosed)), request.closedApply != 0u);

    int goalSlot;
    int count = routeSearchPlan(search, request.entries, request.entryCount, request.goals, request.goalCount, marks, closed, goalSlot);

    routeSearchKeep(search, slot);
    routes_Result(slot) = RouteResult(
        uint(count), goalSlot, search.stopsShort ? 1u : 0u, search.overTheWholeGraph ? 1u : 0u, search.costM,
        search.settledLinks, request.owner, request.stamp);
    routes_Request(slot).state = RouteSlotDone;
}
