#version 460
#extension GL_GOOGLE_include_directive : require

// Every walker's walk planned and claimed, one thread a walker, each at its own room of the plans' rows (walkers.glsl).
// A walker's hold is numbered by the walker until the holds are numbered on the device.

layout(local_size_x = 64) in;

#include "world/town/kernels/walkers_buffers.glsl"

void main()
{
    uint walker = gl_GlobalInvocationID.x;
    if (walker >= figures.walkerCount) return;

    WalkerRow row = walkers[walker];
    WalkerWay planned[WalkerMostWays];
    WalkersPlan plan = walkersPlanTheWalk(row, walker, int(walker), walker * figures.proposedRoom, planned);
    walkers[walker] = row;
    holds[walker] = plan.hold;
    for (int at = 0; at < plan.ways; at++) ways[walker * uint(WalkerMostWays) + uint(at)] = planned[at];
    counts[walker] = uvec4(plan.laidAHold, 0u, uint(plan.ways), plan.rows);
}
