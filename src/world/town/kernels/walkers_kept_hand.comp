#version 460
#extension GL_GOOGLE_include_directive : require

// Walkers left on the device handed back whole as the kept table holds them (app/devicetick/DeviceWalkers.TakeBackTheLeft),
// one thread a walker named: its row and its leg's clock, into the host's own memory, as walkers_kept_out.comp hands
// back the walkers a rebuild changed.

layout(local_size_x = 64) in;

layout(push_constant) uniform Figures
{
    uint count;
} figures;

#include "agents/person/actions/kernels/walker_rows.glsl"
#include "world/town/kernels/walker_out.glsl"

// walkers_kept_out.comp's HandedRow.
struct HandedRow
{
    WalkerOut made;
    uvec4 clock;
};

layout(std430, binding = 0) readonly buffer Kept { WalkerRow kept[]; };
layout(std430, binding = 1) readonly buffer Named { uint named[]; };
layout(std430, binding = 2) readonly buffer Clocks { uvec4 clocks[]; };
layout(std430, binding = 3) writeonly buffer Handed { HandedRow handed[]; };

void main()
{
    uint at = gl_GlobalInvocationID.x;
    if (at >= figures.count) return;

    uint walker = named[at];
    handed[at] = HandedRow(walkerOutOf(kept[walker], walker), clocks[walker]);
}
