#version 460
#extension GL_GOOGLE_include_directive : require

// The switching cars of the decisions due, after car_tick.comp asked them (Switching.Consider past the turn), in two
// passes. Asked to sort (mode), one thread a decision: a car on its step, or not looking again yet, has its decision kept
// here and its clock with it, and one whose look is due is listed — past the device's rooms, left to the town. Asked to
// look, one workgroup a car listed: its step drawn, the body read at every station down it a thread a station, the runs
// those leave merged in their order, and what they hold asked of the claims the town's readers hold a thread a run. What
// each came to is written where the host reads it and the car's clock kept — or, where a look found room for a step or
// more than the device's rooms hold, its decision handed to the town as more than its clock.

// A look's workgroup reads all its stations' two sweeps at once (SwitchMostStations of each): a read is a long walk of the
// atlas, and a look's latency is the reads one thread takes in turn.
layout(local_size_x = 256) in;

// The atlas's figures (DeviceAtlas.AskPush, bodyCount the decisions due), then the passes' own.
layout(push_constant) uniform Push
{
    uint bodyCount;
    int cellsFromX;
    int cellsFromY;
    int cellsWidth;
    int cellsHeight;
    float perCellM;
    float cellM;
    int shift;
    int mask;
    int startShift;
    int rowStartsShift;
    int startsPerCell;
    float metresPerOutside;
    float alongPerMetre;
    uint hasChannels;
    uint stamp;
    uint waysKnown;
    uint markRoom;
    uint mode;
    uint dueRoom;
    uint poolRoom;
} push;

// What a look is drawn and swept by, every figure the host's own (DeviceSwitchLook.Figures).
layout(std430, binding = 20) readonly buffer SwitchFigures
{
    float reactionS;
    float passSpareM;
    float standOffM;
    float gripMargin;
    float brakingMargin;
    float askEveryS;
    float sinceLastDecisionS;
    float tau;
    float tauSquared;
    float fourPiSquared;
    uint firstConnector;
    uint firstFootway;
    uint arcsPerCar;
    uint mostLanes;
    uint mostRunsOfASwitch;
    uint pad;
} switchFigures;

#define ATLAS_FIGURES push
#define ATLAS_BINDING 32
#define SWITCH_PUSH push
#define SWITCH_FIGURES switchFigures
#define PASS_SHAPE_FIGURES switchFigures
#define SPLINE_ARCS lineArcs
#define CAR_LINES lines
#define LANE_CHAIN chain
#define LANE_END ends
#define LANE_BESIDE laneBeside
