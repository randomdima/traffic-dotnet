#define MARKS marks
#define ZEBRA_WAYS zebraWays
#define WAYS_KNOWN waysKnown
#define SWEPT_RUNS swept
#define CLAIM_ROWS claimRows
#define BODY_RUNS bodyRuns
#define PLANNED_RUNS plannedRuns
#define CLAIM_ORDER claimOrder

#include "core/geometry/kernels/arc.glsl"
