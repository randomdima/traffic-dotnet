#version 460
#extension GL_GOOGLE_include_directive : require

// Every walker read back off its body after the step, one thread a walker (TownWorld.StepBodies' walkers after the
// step), into the walker table the next tick's walker tick reads: where it stands, how it moves, and how far that step
// took it. A walker inside something has no body in the world, and its row is its container's business.

layout(local_size_x = 64) in;

#include "bodies_phase.glsl"
#include "world/town/kernels/walker_table.glsl"
#include "core/geometry/kernels/rounded.glsl"

layout(std430, binding = 0) readonly buffer WalkerBodies { int walkerBodies[]; };
layout(std430, binding = 1) buffer Walkers { WalkerTableRow walkers[]; };
layout(std430, binding = 2) readonly buffer Pose { vec4 pose[]; };
layout(std430, binding = 3) readonly buffer Motion { vec4 motion[]; };

void main()
{
    uint walker = gl_GlobalInvocationID.x;
    if (walker >= count) return;

    WalkerTableRow row = walkers[walker];
    if ((row.flags & WalkerTableInside) != 0u) return;

    int body = walkerBodies[walker];
    vec2 nowM = pose[body].xy;
    precise vec2 movedM = nowM - row.positionM;
    precise float movedSquared = movedM.x * movedM.x + movedM.y * movedM.y;
    precise float walkedM = row.distanceWalkedM + roundedSqrt(movedSquared);
    row.positionM = nowM;
    row.velocityMps = motion[body].xy;
    row.distanceWalkedM = walkedM;
    walkers[walker] = row;
}
