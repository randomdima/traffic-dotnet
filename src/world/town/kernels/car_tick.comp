#version 460
#extension GL_GOOGLE_include_directive : require

// The following cars' ticks, one thread a car named in the list taken (car_tick.glsl), over the tyres' table and each
// car's line in the fleet's own layout — every table indexed by the car — and the claims as they were cut: the command
// each leaves where the tyre pass reads it.
//
// Asked to decide (mode), it is instead the decisions put off a tick of the cars named in the list due, read off what their
// last tick left before this one runs (car_decide.glsl): each one's verdict where the host reads it, its clock run where
// that is the whole of its decision, and where it is not, what the host decides it on, written into the host's memory.

layout(local_size_x = 64) in;

// DrivingGround.MostWaysAlongALine.
#define LINE_MOST_WAYS 23u

layout(push_constant) uniform Figures
{
    uint carCount;
    uint arcsPerCar;
    uint mostLanes;
    uint firstConnector;
    float roundingM;
    float slowerToPassMps;
    float queueInCarLengths;
    float dtS;
    float lookaheadS;
    float gripMargin;
    float brakingMargin;
    float stopSpeedMps;
    float waitingToPassBrakingShare;
    float reactionS;
    float callPaceMps;
    float standardGravityMps2;
    float wheelSpinFadeMps;
    float wheelSpinAllowanceMps;
    float markSlipMps;
    float markCorneringSlipMps;
    float ploughCrawlMps;
    float engineBrakingMps2;
    float passSpareM;
    uint mode;
    uint stamp;
    float sinceLastDecisionS;
    float slowerToSwitchMps;
} figures;

// Figures.mode.
const uint ModeTick = 0u;
const uint ModeDecide = 1u;

#define TYRE_FIGURES figures
#define CAR_TICK_FIGURES figures
#define FOLLOWER_FIGURES figures
#define LINE_FIGURES figures
#define CONTEXT_FIGURES figures
#define LINE_WAYS_FIGURES figures
#define LINE_ONWARD_FIGURES figures
#define SPLINE_ARCS lineArcs
#define LINE_ENTRIES entries
#define FOLLOWER_ENTRIES entries
#define LANE_CHAIN chain
#define LANE_START starts
#define LANE_END ends
#define LANE_FIRST_ARC firstArcs
#define JOIN_BREAKS breaks
#define LANE_LENGTH laneLength
#define CONNECTOR_AT connectorAt
#define CONNECTOR_TO connectorTo
#define CONNECTOR_RUNG connectorRung
#define CONNECTOR_LENGTH connectorLength
#define LANE_PASSABLE lanePassable
#define CLAIM_ROWS rows
#define PLANNED_RUNS plannedRuns
#define PLANNED_ORDER plannedOrder

#include "core/geometry/kernels/arc.glsl"
#include "agents/car/body/kernels/car_build.glsl"
#include "agents/car/body/kernels/tyre_rows.glsl"
#include "agents/car/body/kernels/tyre.glsl"
#include "agents/car/control/kernels/car_line.glsl"
#include "world/road/kernels/claims_rows.glsl"

layout(std430, binding = 0) readonly buffer Builds { CarBuildRow builds[]; };
layout(std430, binding = 1) readonly buffer BuildOf { uint buildOf[]; };
layout(std430, binding = 2) readonly buffer Poses { TyrePose poses[]; };
layout(std430, binding = 3) buffer Commands { TyreCommand commands[]; };
layout(std430, binding = 4) buffer LineArcs { Arc lineArcs[]; };
layout(std430, binding = 5) buffer Entries { float entries[]; };
layout(std430, binding = 6) buffer Chain { int chain[]; };
layout(std430, binding = 7) buffer Starts { float starts[]; };
layout(std430, binding = 8) buffer Ends { float ends[]; };
layout(std430, binding = 9) buffer FirstArcs { uint firstArcs[]; };
layout(std430, binding = 10) buffer Breaks { uint breaks[]; };
layout(std430, binding = 11) buffer Lines { CarLineRow lines[]; };
layout(std430, binding = 12) readonly buffer LaneLength { float laneLength[]; };
layout(std430, binding = 13) readonly buffer ConnectorAt { uint connectorAt[]; };
layout(std430, binding = 14) readonly buffer ConnectorTo { int connectorTo[]; };
layout(std430, binding = 15) readonly buffer ConnectorRung { uint connectorRung[]; };
layout(std430, binding = 16) readonly buffer ConnectorLength { float connectorLength[]; };
layout(std430, binding = 17) readonly buffer LanePassable { uint lanePassable[]; };
layout(std430, binding = 18) readonly buffer Rows { ClaimRow rows[]; };
layout(std430, binding = 19) readonly buffer PlannedRuns { uvec2 plannedRuns[]; };
layout(std430, binding = 20) readonly buffer PlannedOrder { uint plannedOrder[]; };

#include "core/geometry/kernels/arc_chain.glsl"
#include "world/road/kernels/road_joins.glsl"
#include "agents/car/control/kernels/line_onward.glsl"
#include "agents/car/control/kernels/line_ways.glsl"
#include "agents/car/control/kernels/line.glsl"
#include "agents/car/control/kernels/follower.glsl"
#include "world/town/kernels/drive_context.glsl"
#include "world/town/kernels/car_tick.glsl"
#include "core/geometry/kernels/rounded.glsl"
#include "world/town/kernels/car_decide.glsl"

layout(std430, binding = 21) readonly buffer Cutters { ClaimRow cutters[]; };
layout(std430, binding = 22) readonly buffer Grants { CarGrantRow grants[]; };
layout(std430, binding = 23) readonly buffer Told { CarToldRow told[]; };
layout(std430, binding = 24) buffer Ticks { CarTickRow ticks[]; };
layout(std430, binding = 25) writeonly buffer Contexts { DriveContextRow contexts[]; };
layout(std430, binding = 26) buffer Boxes { BoxAheadRow boxes[]; };
layout(std430, binding = 27) readonly buffer Taken { uint taken[]; };
layout(std430, binding = 28) buffer Passes { OvertakeRow passes[]; };
layout(std430, binding = 29) readonly buffer HoldBits { uint holdBits[]; };

layout(std430, binding = 30) buffer Briefs { CarBriefRow briefs[]; };
layout(std430, binding = 31) readonly buffer DecideList { uint decideList[]; };
layout(std430, binding = 32) readonly buffer DecideTerms { CarDecideTermsRow decideTerms[]; };
layout(std430, binding = 33) buffer Clocks { vec2 clocks[]; };
layout(std430, binding = 34) writeonly buffer Verdicts { uint verdicts[]; };
layout(std430, binding = 35) writeonly buffer DecidedAt { uint decidedAt[]; };
layout(std430, binding = 36) writeonly buffer DecideOut { CarOutRow decideOut[]; };
layout(std430, binding = 37) readonly buffer TyreCars { TyreCarRow tyreCars[]; };

// Verdicts: the stamp of the tick that wrote one, shifted past whether the decision is more than the clock.
const uint VerdictMore = 1u;

// One car's decision put off, asked of what its last tick left (car_decide.glsl).
void decideOne(uint car)
{
    CarTickRow tick = ticks[car];
    CarBriefRow brief = briefs[car];
    CarDecideTermsRow terms = decideTerms[car];
    vec2 clockWas = clocks[car];
    vec2 clock = clockWas;
    bool more = decideMoreThanTheClock(
        car, builds[buildOf[car]], lines[car], tick, told[car], brief, holdBits[car], cutters[car], grants[car].cutOn, terms,
        clock);
    verdicts[car] = (figures.stamp << 1u) | (more ? VerdictMore : 0u);
    if (more) decidedAt[car] = figures.stamp;
    else clocks[car] = clock;

    // Checked, what every decision asked was read off goes back, the town to read the same verdict off it.
    if (more || (terms.flags & DecideChecked) != 0u)
    {
        decideOut[car] = CarOutRow(tick, commands[car], brief, tyreCars[car], clockWas.x, clockWas.y, figures.stamp);
    }
}

void main()
{
    if (gl_GlobalInvocationID.x >= figures.carCount) return;

    if (figures.mode == ModeDecide)
    {
        decideOne(decideList[gl_GlobalInvocationID.x]);
        return;
    }

    uint car = taken[gl_GlobalInvocationID.x];
    CarToldRow toldRow = told[car];
    toldRow.flags |= holdBits[car] & (ContextHasAHold | ContextCut);
    CarTickRow tick = ticks[car];
    CarLineRow line = lines[car];
    TyreCommand command = commands[car];
    BoxAheadRow box = boxes[car];
    OvertakeRow pass = passes[car];
    DriveContextRow context;
    carTick(
        car, builds[buildOf[car]], poses[car], toldRow, grants[car], cutters[car], tick, line, command, context, box, pass);

    ticks[car] = tick;
    lines[car] = line;
    commands[car] = command;
    contexts[car] = context;
    boxes[car] = box;
    passes[car] = pass;
    briefs[car] = CarBriefRow(
        context.authorityM, context.passAsideM, box.toTheBoxM, box.lightAheadM, box.flags | (context.blocked != 0u ? BriefBlocked : 0u));
}
