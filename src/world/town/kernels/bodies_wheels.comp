#version 460
#extension GL_GOOGLE_include_directive : require

// Every car's wheels spent on its body, one thread a car, in wheel order (TownWorld.StepBodies' loop over the cars):
// each impulse as the tyre pass left it in its table (DeviceTyres.ImpulseTable), at its point. A car that rested parked
// on its last tick spends nothing, as on the host. One body a car, so no two threads write one body.

layout(local_size_x = 64) in;

#include "bodies_phase.glsl"
#include "world/physics/kernels/impulse.glsl"

layout(std430, binding = 0) readonly buffer CarBodies { CarBodyRow carBodies[]; };
layout(std430, binding = 1) readonly buffer ImpulseRows { vec4 impulseRows[]; };
layout(std430, binding = 2) readonly buffer Pose { vec4 pose[]; };
layout(std430, binding = 3) buffer Motion { vec4 motion[]; };
layout(std430, binding = 4) readonly buffer Mass { vec2 mass[]; };

void main()
{
    uint car = gl_GlobalInvocationID.x;
    if (car >= count) return;

    CarBodyRow row = carBodies[car];
    if ((row.flags & CarRestsParked) != 0u) return;

    int body = row.body;
    vec2 positionM = pose[body].xy;
    vec2 inverses = mass[body];
    vec4 moving = motion[body];
    for (uint wheel = 0u; wheel < wheelsACar; wheel++)
    {
        vec4 spent = impulseRows[car * wheelsACar + wheel];
        moving = impulsedAt(moving, positionM, inverses, spent.xy, spent.zw);
    }

    motion[body] = moving;
}
