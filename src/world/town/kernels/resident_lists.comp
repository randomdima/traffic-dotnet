#version 460
#extension GL_GOOGLE_include_directive : require

// The resident town's lists (app/devicetick/ResidentTown), off the town as the device holds it, each in any order — every
// kernel run over one writes each agent's own rows alone:
//   ListTaken      every car the car tick takes (DeviceCarTick.Takes): driven, not on a bar, and following its line,
//                  moving across, rejoining or overtaking (whether an overtaking car is off the lane of its pass is not
//                  asked yet);
//   ListCarsLeft   every other car not on a bar, whose action's own tick the town ticks (TownWorld.TickCar);
//   ListCarsDue    every car whose turn of the decisions this tick is (TickGroups.Turn of its agent), not on a bar;
//   ListWalkersDue every walker whose turn it is.
// Once listed, each count's workgroups are written where an indirect dispatch reads them, and each list padded to its last
// workgroup with no agent.

#include "world/town/kernels/town_state.glsl"

layout(local_size_x = 64) in;

layout(push_constant) uniform Push
{
    uint cars;
    uint people;
    uint mode;
    uint group;

    // The decisions' tick modulo their groups, and the groups (TickGroups).
    uint dueTick;
    uint groups;
} push;

const uint ModeList = 0u;
const uint ModeClose = 1u;

const uint ListTaken = 0u;
const uint ListCarsLeft = 1u;
const uint ListCarsDue = 2u;
const uint ListWalkersDue = 3u;
const uint Lists = 4u;

// No agent, in a list's padding (car_tick.comp's TakenNone).
const uint ListNone = 0xFFFFFFFFu;

// Where the lists stand: four words a list (its count, then its dispatch's three words), and each list's table.
const uint ResidentListCounts = 2u;
const uint ResidentLists = 3u;

#define listWord(list, word) TOWN(Uints, ResidentListCounts).v[4u * (list) + (word)]
#define listOf(list) TOWN(Uints, ResidentLists + (list))

bool takes(uint car)
{
    uint action = cars_Action(car);
    bool onAPass = cars_PassWord(car, 0u) >= 0;
    return cars_Driven(car) != 0u
           && ((action == CarActionFollow || action == CarActionRejoin) && !onAPass || action == CarActionSwitch
               || action == CarActionOvertake);
}

bool dueOf(uint agent) { return push.groups <= 1u || (push.dueTick + agent) % push.groups == 0u; }

void add(uint list, uint agent) { listOf(list).v[atomicAdd(listWord(list, 0u), 1u)] = agent; }

void close(uint list, uint at, uint room)
{
    uint count = listWord(list, 0u);
    uint padded = min(((count + push.group - 1u) / push.group) * push.group, room);
    if (at == 0u)
    {
        listWord(list, 1u) = (count + push.group - 1u) / push.group;
        listWord(list, 2u) = 1u;
        listWord(list, 3u) = 1u;
    }

    if (at >= count && at < padded) listOf(list).v[at] = ListNone;
}

void main()
{
    uint at = gl_GlobalInvocationID.x;
    if (push.mode == ModeClose)
    {
        close(ListTaken, at, push.cars);
        close(ListCarsLeft, at, push.cars);
        close(ListCarsDue, at, push.cars);
        close(ListWalkersDue, at, push.people);
        return;
    }

    if (at < push.cars && recovery_OnTheHookOf(at) < 0)
    {
        add(takes(at) ? ListTaken : ListCarsLeft, at);
        if (dueOf(townCounts.firstCarAgent + at)) add(ListCarsDue, at);
    }

    if (at < push.people && dueOf(at)) add(ListWalkersDue, at);
}
