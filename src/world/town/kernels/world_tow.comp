#version 460
#extension GL_GOOGLE_include_directive : require

// Every car's wheels (EVA-5, TowBar; ManagedWorld.TrailerWheels, StepTheBodies), one thread a car, after the tyre pass: a
// car on an arm rolls on the pair at the far end from the fork — the lifted pair spends nothing, the pair down holds what
// it can of its sideways slip and drags at the ground's drag, and turns with the road; one on two arms rolls on none —
// and then every car's wheels are
// spent on its body in wheel order, each impulse as the tyre pass or the arm left it in its table
// (DeviceTyres.ImpulseTable), at its point. The arm itself is the solver's link (SOL-38, solve.comp).

layout(local_size_x = 64) in;

#include "world/town/kernels/world.glsl"
#include "agents/car/body/kernels/car_build.glsl"
#include "agents/car/body/kernels/tyre_rows.glsl"
#include "world/physics/kernels/impulse.glsl"

// The ground under a patch (DeviceTyres.SurfaceRow): off every way, then on one.
struct TowSurface
{
    float coefficient;
    float dragMps2;
    float markThresholdM2S3;
    uint ploughs;
};

layout(std430, binding = 0) readonly buffer Cars { WorldCar cars[]; };
layout(std430, binding = 1) readonly buffer Builds { CarBuildRow builds[]; };
layout(std430, binding = 2) readonly buffer BuildOf { uint buildOf[]; };
layout(std430, binding = 3) readonly buffer Poses { TyrePose poses[]; };
layout(std430, binding = 4) readonly buffer CarRows { TyreCarRow carRows[]; };
layout(std430, binding = 5) readonly buffer Grounds { TowSurface grounds[]; };
layout(std430, binding = 6) buffer ImpulseRows { vec4 impulseRows[]; };
layout(std430, binding = 7) buffer WheelRows { TyreWheelRow wheelRows[]; };
layout(std430, binding = 8) readonly buffer Pose { vec4 pose[]; };
layout(std430, binding = 9) buffer Motion { vec4 motion[]; };
layout(std430, binding = 10) readonly buffer Mass { vec2 mass[]; };

const int TowWheels = 2;
const int FrontPair = 0;
const int RearPair = 2;

// TyreModel.Wheels.
const uint WheelsACar = 4u;

vec2 rightOf(vec2 forward) { return vec2(-forward.y, forward.x); }

// TyreModel.WheelAtM.
vec2 wheelAtM(CarBuildRow car, int wheel)
{
    precise float front = car.wheelbaseM - car.centreAheadOfAxleM;
    return vec2(wheel < 2 ? front : -car.centreAheadOfAxleM, wheel % 2 == 0 ? car.halfTrackM : -car.halfTrackM);
}

void trailerWheels(uint car, WorldCar row)
{
    // Held at both ends, it is carried whole between two arms and no wheel of it is down.
    if ((row.flags & CarHeldAtTheNose) != 0u && (row.flags & CarHeldAtTheTail) != 0u)
    {
        for (uint wheel = 0u; wheel < WheelsACar; wheel++) impulseRows[car * WheelsACar + wheel] = vec4(0.0);
        return;
    }

    bool byTheTail = (row.flags & CarHeldAtTheTail) != 0u;
    int down = byTheTail ? FrontPair : RearPair;
    int up = byTheTail ? RearPair : FrontPair;
    CarBuildRow build = builds[buildOf[car]];
    TyrePose p = poses[car];
    vec2 right = rightOf(p.forward);
    float loadKg = p.massKg * world.onTheTrailerAxleShare / float(TowWheels);
    uint onAWay = tyreWheelsOnAWayOf(carRows[car]);
    precise float alongMps = dot(p.velocityMps, p.forward);

    for (int wheel = 0; wheel < TowWheels; wheel++)
    {
        impulseRows[car * 4u + uint(up + wheel)] = vec4(0.0);

        int at = down + wheel;
        vec2 atBody = wheelAtM(build, at);
        precise vec2 atM = p.positionM + (p.forward * atBody.x) + (right * atBody.y);
        vec2 fromCentreM = atM - p.positionM;
        precise vec2 velocityMps = p.velocityMps + (p.yawRateRadPerS * vec2(-fromCentreM.y, fromCentreM.x));
        TowSurface surface = grounds[(onAWay >> uint(at)) & 1u];
        float wheelAlongMps = dot(velocityMps, p.forward);
        float acrossMps = dot(velocityMps, right);

        precise float wantAcrossNs = -acrossMps * loadKg;
        precise float budgetNs = build.gripMps2 * surface.coefficient * loadKg * world.dtS;
        float acrossNs = sign(wantAcrossNs) * min(abs(wantAcrossNs), budgetNs);
        float dragNs = surface.dragMps2 <= 0.0
            ? 0.0
            : -sign(wheelAlongMps) * min(surface.dragMps2 * loadKg * world.dtS, abs(wheelAlongMps) * loadKg);

        precise vec2 impulseNs = (right * acrossNs) + (p.forward * dragNs);
        impulseRows[car * 4u + uint(at)] = vec4(impulseNs, atM);
        wheelRows[car * 4u + uint(at)].spinMps = alongMps;
    }
}

// Every wheel of the car spent on its body (PhysicsWorld.ApplyImpulseAt), in wheel order as on the host.
void spendTheWheels(uint car, int body)
{
    vec2 positionM = pose[body].xy;
    vec2 inverses = mass[body];
    vec4 moving = motion[body];
    for (uint wheel = 0u; wheel < WheelsACar; wheel++)
    {
        vec4 spent = impulseRows[car * WheelsACar + wheel];
        moving = impulsedAt(moving, positionM, inverses, spent.xy, spent.zw);
    }

    motion[body] = moving;
}

void main()
{
    uint car = gl_GlobalInvocationID.x;
    if (car >= world.count) return;

    WorldCar row = cars[car];
    if ((row.flags & (CarHeldAtTheNose | CarHeldAtTheTail)) != 0u) trailerWheels(car, row);
    spendTheWheels(car, row.body);
}
