#version 460
#extension GL_GOOGLE_include_directive : require

// What the town changed of the walkers a device keeps for its rebuilds since it last wrote them, written over their rows
// (app/devicetick/DeviceWalkers' kept patches), one thread a patch: the town's row whole — but the straight the walker
// walks, which only the device's walks commit to once it keeps the walker, where it kept it already. Written as the row
// stands before the rebuild's stages too (walkers_kept_gather.comp).

layout(local_size_x = 64) in;

layout(push_constant) uniform Figures
{
    uint patchCount;
} figures;

#include "agents/person/actions/kernels/walker_rows.glsl"

// DeviceWalkers.KeptPatch, field for field: the town's row, which walker it is, and whether the device keeps it already.
struct KeptPatch
{
    WalkerRow row;
    uint walker;
    uint kept;
};

layout(std430, binding = 0) readonly buffer Patches { KeptPatch patches[]; };
layout(std430, binding = 1) buffer Kept { WalkerRow kept[]; };
layout(std430, binding = 2) writeonly buffer Before { WalkerRow before[]; };

void main()
{
    uint at = gl_GlobalInvocationID.x;
    if (at >= figures.patchCount) return;

    KeptPatch written = patches[at];
    WalkerRow row = written.row;
    if (written.kept != 0u)
    {
        WalkerRow was = kept[written.walker];
        row.straightFromM = was.straightFromM;
        row.straightToM = was.straightToM;
        row.straightRuns = was.straightRuns;
        row.flags = (row.flags & ~WalkerOnAStraight) | (was.flags & WalkerOnAStraight);
    }

    kept[written.walker] = row;
    before[written.walker] = row;
}
