#version 460
#extension GL_GOOGLE_include_directive : require

// A tick's control signals taken into the world (WorldLayer.Signals, ManagedWorld.Take). The host writes the commands, the
// aims and what a car shows from the front of the buffer and the rest from the back, in order (DeviceWorld.WriteTheSignals),
// and runs each mode only where it has any. In mode 0 a thread a signal from the front — the host sends only an agent's
// last of each, so no two threads write one row; in mode 1 one thread over the back in order, everything else — what puts
// a body somewhere, takes it out of the world, refilters or couples it — and an aim the host marked as given after the
// walker was put down (SignalInOrder), so whichever of the two came last stands. Whatever moves a body's filter or place
// thaws it (PhysicsWorld.Wake); the host counts the rest of one put down or contained afresh (DeviceSolver.CountAfresh).
//
// A car's tyres read its body off its pose row (TyrePose), which the step's view writes as the step leaves the body
// (world_view.comp): what a signal does to a car's body it does to that row too, and a car thawed is no longer frozen as
// the next step begins (CarFrozenNext).

layout(local_size_x = 64) in;

#include "world/town/kernels/world.glsl"
#include "agents/car/body/kernels/tyre_rows.glsl"
#include "world/physics/kernels/filter.glsl"
#include "world/road/kernels/line_followed.glsl"

layout(std430, binding = 0) readonly buffer Signals { WorldSignal signals[]; };
layout(std430, binding = 1) readonly buffer CarOf { int carOf[]; };
layout(std430, binding = 2) readonly buffer WalkerOf { int walkerOf[]; };
layout(std430, binding = 3) buffer Commands { TyreCommand commands[]; };
layout(std430, binding = 4) buffer CarRows { TyreCarRow carRows[]; };
layout(std430, binding = 5) buffer WheelRows { TyreWheelRow wheelRows[]; };
layout(std430, binding = 6) buffer Cars { WorldCar cars[]; };
layout(std430, binding = 7) buffer Walkers { WorldWalker walkers[]; };
layout(std430, binding = 8) buffer Pose { vec4 pose[]; };
layout(std430, binding = 9) buffer HeadingB { float headingRad[]; };
layout(std430, binding = 10) buffer Motion { vec4 motion[]; };
layout(std430, binding = 11) buffer MotionIntoTick { vec4 motionIntoTick[]; };
layout(std430, binding = 12) readonly buffer ShapeB { vec4 shape[]; };
layout(std430, binding = 13) buffer Bounds { vec4 bounds[]; };
layout(std430, binding = 14) buffer Filter { uint filter_[]; };
layout(std430, binding = 15) buffer Poses { TyrePose poses[]; };
layout(std430, binding = 16) buffer Follows { LineFollowedRow follows[]; };

void thaw(int body, int car)
{
    filter_[body] &= ~(world.frozenBit | world.filedFrozenBit);
    if (car >= 0) cars[car].flags &= ~CarFrozenNext;
}

void still(int body, int car)
{
    motion[body] = vec4(0.0);
    motionIntoTick[body] = vec4(0.0);
    if (car < 0) return;

    poses[car].velocityMps = vec2(0.0);
    poses[car].yawRateRadPerS = 0.0;
}

// Shape.HalfBoundsM.
vec2 halfBounds(vec2 rotation, vec4 shaped)
{
    float cosA = abs(rotation.x);
    float sinA = abs(rotation.y);
    precise vec2 half_ = vec2(
        shaped.x * cosA + shaped.y * sinA + shaped.z,
        shaped.x * sinA + shaped.y * cosA + shaped.z);
    return half_;
}

void takeACommandOrAnAim(WorldSignal s)
{
    uint flags = signalFlags(s);
    if (signalAction(s) == SignalDrive)
    {
        int car = carOf[s.body];
        commands[car] = TyreCommand(
            s.p01.x, s.p01.y, s.p23.x, ((flags & DriveHandbrake) != 0u ? 1u : 0u) | ((flags & DriveReverse) != 0u ? 2u : 0u));
        carRows[car].flags = (carRows[car].flags & ~1u) | ((flags & DriveUnderAHand) != 0u ? 1u : 0u);
        return;
    }

    if (signalAction(s) == SignalShow)
    {
        int car = carOf[s.body];
        cars[car].flags = (cars[car].flags & ~CarShows) | ((flags << CarShowsShift) & CarShows);
        return;
    }

    // p01: the lane's and the join's bits; p23: where the stretch stops, and where along it the car is (ControlSignal.Follow).
    if (signalAction(s) == SignalFollow)
    {
        follows[carOf[s.body]] = LineFollowedRow(
            floatBitsToInt(s.p01.x), floatBitsToInt(s.p01.y), s.p23.x, s.p23.y, s.p23.y, uintBitsToFloat(0x7fc00000u), flags, 0u);
        return;
    }

    if (signalAction(s) == SignalWalk)
    {
        int walker = walkerOf[s.body];
        walkers[walker].aimM = s.p01;
        walkers[walker].flags = (walkers[walker].flags & WalkerInside) | (flags & (WalkMoving | WalkOnFeet | WalkFaces));
    }
}

void takeAnEvent(WorldSignal s)
{
    int body = s.body;
    uint action = signalAction(s);
    uint flags = signalFlags(s);
    int walker = walkerOf[body];
    int car = carOf[body];

    if (action == SignalPlace)
    {
        // p01 where, p23 the rotation the host worked out of p45.x, the heading (PhysicsWorld.Release).
        pose[body] = vec4(s.p01, s.p23);
        headingRad[body] = s.p45.x;
        vec2 half_ = halfBounds(s.p23, shape[body]);
        bounds[body] = vec4(s.p01 - half_, s.p01 + half_);
        still(body, car);
        thaw(body, car);
        filter_[body] |= world.enabledBit;
        if (car >= 0)
        {
            poses[car].positionM = s.p01;
            poses[car].forward = s.p23;
            poses[car].headingRad = s.p45.x;
        }

        if (walker >= 0)
        {
            walkers[walker].flags &= ~WalkerInside;
            walkers[walker].headingRad = s.p45.x;
            walkers[walker].declaredMps = vec2(0.0);
            walkers[walker].aimM = s.p01;
        }

        return;
    }

    if (action == SignalContain)
    {
        still(body, car);
        thaw(body, car);
        filter_[body] &= ~world.enabledBit;
        if (walker >= 0)
        {
            walkers[walker].flags |= WalkerInside;
            walkers[walker].declaredMps = vec2(0.0);
        }

        return;
    }

    if (action == SignalLayer)
    {
        // p01: the category's and the mask's bits, as the host derives them (PhysicsWorld.MaskOf, DeviceSolver.LayerByte).
        filter_[body] = filterOnLayer(filter_[body], floatBitsToUint(s.p01.x), floatBitsToUint(s.p01.y));
        thaw(body, car);
        return;
    }

    if (action == SignalChannels)
    {
        filter_[body] = filterOnChannels(filter_[body], flags);
        thaw(body, car);
        return;
    }

    if (action == SignalTow)
    {
        // p01.x: the tractor's car index, or −1.
        cars[car].tractor = floatBitsToInt(s.p01.x);
        cars[car].flags = (cars[car].flags & ~CarByTheTail) | ((flags & TowByTheTail) != 0u ? CarByTheTail : 0u);
        return;
    }

    if (action == SignalClearWheels)
    {
        carRows[car].slipThrottle = 1.0;
        carRows[car].flags &= ~6u;
        vec2 atM = pose[body].xy;
        for (uint wheel = 0u; wheel < 4u; wheel++) wheelRows[uint(car) * 4u + wheel] = TyreWheelRow(atM, 0.0, 0.0, 0.0, 0u);
    }
}

void main()
{
    if (world.mode == 0u)
    {
        uint at = gl_GlobalInvocationID.x;
        if (at < world.count) takeACommandOrAnAim(signals[at]);
        return;
    }

    if (gl_GlobalInvocationID.x != 0u) return;

    uint last = uint(signals.length()) - 1u;
    for (uint taken = 0u; taken < world.count; taken++)
    {
        WorldSignal s = signals[last - taken];
        if (signalInOrder(s)) takeACommandOrAnAim(s);
        else takeAnEvent(s);
    }
}
