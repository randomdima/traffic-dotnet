#version 460
#extension GL_GOOGLE_include_directive : require

// Every walker in the world handed back off its body after the step, one thread a walker, into memory the host reads
// (app/devicetick/DeviceTownBodies): where it stands and how it moves, which is what the town's people are written
// from, and — where the walkers' tick keeps them (walkerTableBound) — how far it has walked, as that table summed it. A
// walker whose body is out of the world is written nothing — it did not move, and the host skips it.

layout(local_size_x = 64) in;

#include "bodies_phase.glsl"
#include "world/town/kernels/walker_table.glsl"

// One walker as the step left it (DeviceBodyPhase.WalkedRow).
struct WalkedRow
{
    vec2 positionM;
    vec2 velocityMps;
    float distanceWalkedM;
    float pad0;
    float pad1;
    float pad2;
};

layout(std430, binding = 0) readonly buffer WalkerBodies { int walkerBodies[]; };
layout(std430, binding = 1) readonly buffer Filter { uvec4 filter_[]; };
layout(std430, binding = 2) readonly buffer Pose { vec4 pose[]; };
layout(std430, binding = 3) readonly buffer Motion { vec4 motion[]; };
layout(std430, binding = 4) writeonly buffer Walked { WalkedRow walked[]; };
layout(std430, binding = 5) readonly buffer Walkers { WalkerTableRow walkers[]; };

void main()
{
    uint walker = gl_GlobalInvocationID.x;
    if (walker >= count) return;

    int body = walkerBodies[walker];
    if ((filter_[body].x & enabledBit) == 0u) return;

    float walkedM = walkerTableBound != 0u ? walkers[walker].distanceWalkedM : 0.0;
    walked[walker] = WalkedRow(pose[body].xy, motion[body].xy, walkedM, 0.0, 0.0, 0.0);
}
