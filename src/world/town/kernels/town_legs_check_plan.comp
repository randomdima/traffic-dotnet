#version 460
#extension GL_GOOGLE_include_directive : require

// The leg's probe of a route asked for (town_legs_check.glsl): TownWorld.TryPlan from the listed lane, and what it answered.

#include "world/town/kernels/town_legs_check.glsl"

void main()
{
    for (uint row = 0u; row < push.count; row++)
    {
        reached = 0u;
        uint car = uint(listedCar(row));
        uint found = town_TryPlan(car, listedArgument(row));
        putTheCar(row, car);
        put(row, 29u, found);
    }

    putTheCounts();
}
