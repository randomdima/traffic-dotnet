#version 460
#extension GL_GOOGLE_include_directive : require

// Whether each candidate is laid as a body of its own — the first piece of its holder's on its way — or grown into the
// one that is (LaneOccupancy.LayBody), one thread a candidate (rebuild_bodies.glsl).

layout(local_size_x = 64) in;

layout(push_constant) uniform Figures
{
    uint walkerCount;
    uint carCount;
    uint wayCount;
    uint coverRoom;
    uint carRoom;
} figures;

#include "world/town/kernels/rebuild_bodies.glsl"

void main()
{
    uint candidate = gl_GlobalInvocationID.x;
    if (candidate >= tally[TallyCandidates]) return;

    ClaimRow laid = bodiesCandidate(candidateRefs[candidate]);
    if (bodiesRefused(laid))
    {
        firsts[candidate] = 0u;
        return;
    }

    uint start = wayStarts[laid.way];
    for (uint at = start; at < start + wayCounts[laid.way]; at++)
    {
        uint other = candidateOrder[at];
        if (other >= candidate) break;
        if (!bodiesSameHolder(laid, bodiesCandidate(candidateRefs[other]))) continue;

        firsts[candidate] = 0u;
        return;
    }

    firsts[candidate] = 1u;
}
