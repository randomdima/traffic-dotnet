#version 460
#extension GL_GOOGLE_include_directive : require

// Whether a body stands inside what is left of a car's pass (LaneOccupancy.FirstBodyIn over Following.AsksOfItsPass),
// one thread a car, read off the bodies and passes the rebuild has laid and listed: the first stretch its asks name with
// one in it, the body nearest the stretch's start, and where on the car's line that stops it — or none, and the car's
// claim is the plan the host laid past its pass.

layout(local_size_x = 64) in;

layout(push_constant) uniform Figures
{
    uint carCount;
} figures;

#include "world/road/kernels/claims_rows.glsl"
#include "world/town/kernels/rebuild_rows.glsl"

layout(std430, binding = 0) readonly buffer CarClaims { CarClaimRow carClaims[]; };
layout(std430, binding = 1) readonly buffer Asks { BodyAskRow asks[]; };
layout(std430, binding = 2) readonly buffer Rows { ClaimRow rows[]; };
layout(std430, binding = 3) readonly buffer BodyRuns { uvec2 bodyRuns[]; };
layout(std430, binding = 4) readonly buffer Order { uint order[]; };
layout(std430, binding = 5) writeonly buffer Answers { uvec4 answers[]; };

// The first body over one ask's stretch, in its way's list (LaneOccupancy.AheadBody, AheadBodyOf), or NoRow.
uint asksFirstBody(BodyAskRow ask, int asker)
{
    bool onFoot = (ask.flags & AskOnFoot) != 0u;
    uvec2 run = bodyRuns[uint(ask.way)];
    for (uint at = 0u; at < run.y; at++)
    {
        uint slot = order[run.x + at];
        ClaimRow body = rows[slot];
        if (onFoot ? body.fromM >= ask.toM : body.fromM > ask.toM) break;
        if (body.toM <= ask.fromM) continue;
        if (onFoot ? claimRoster(body) != RosterWalking : body.occupant == asker && claimRoster(body) == RosterDriving) continue;

        return slot;
    }

    return NoRow;
}

void main()
{
    uint car = gl_GlobalInvocationID.x;
    if (car >= figures.carCount) return;

    CarClaimRow claim = carClaims[car];
    for (uint at = 0u; at < claim.askCount; at++)
    {
        BodyAskRow ask = asks[uint(claim.askFirst) + at];
        uint body = asksFirstBody(ask, int(car));
        if (body == NoRow) continue;

        // LineWays.OnTheLineM: where the body's near edge, or the stretch's start, falls on the car's line.
        precise float fromTheBodyM = ask.inTheWayM + (max(ask.fromM, rows[body].fromM) - ask.fromM);
        float inTheWayM = (ask.flags & AskFromTheBody) != 0u ? fromTheBodyM : ask.inTheWayM;
        answers[car] = uvec4(1u, floatBitsToUint(inTheWayM), body, uint(ask.way));
        return;
    }

    answers[car] = uvec4(0u, 0u, NoRow, 0xFFFFFFFFu);
}
