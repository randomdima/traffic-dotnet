#version 460
#extension GL_GOOGLE_include_directive : require

// The shallow state handed back behind every step (WorldView; ManagedWorld.WriteTheView), one thread a car and then one a
// walker, written straight into memory the host reads. A car is read off its body: whether it is frozen and whether it
// was through the whole step, which wheels stand on a way, its channels and how deep it was into what it touched; a
// walker the same, and whether it declared a velocity. The first thread hands back the covers listed beside the view,
// and on a step takes the marks the tyres laid into the ground's ring (drift_marks.glsl).
//
// With ViewStepped in the mode the pass is the step's own and keeps what the step settled — the acceleration a car
// settles onto its springs with, lagged toward what its patches spent this tick, and the distance walked — and each car's
// pose as its tyres read it at the next step, and whether it comes into that step frozen, until a signal moves its body
// (world_signals.comp). Without it (the view written again off the clock, DeviceWorld.ReadCovers) it only reads, so a
// second pass moves nothing.

layout(local_size_x = 64) in;

#include "world/town/kernels/world.glsl"
#include "agents/car/body/kernels/tyre_rows.glsl"
#include "core/geometry/kernels/rounded.glsl"
#include "world/physics/kernels/filter.glsl"

layout(std430, binding = 0) buffer Cars { WorldCar cars[]; };
layout(std430, binding = 1) buffer Walkers { WorldWalker walkers[]; };
layout(std430, binding = 2) readonly buffer ImpulseRows { vec4 impulseRows[]; };
layout(std430, binding = 3) buffer Poses { TyrePose poses[]; };
layout(std430, binding = 4) readonly buffer CarRows { TyreCarRow carRows[]; };
layout(std430, binding = 5) readonly buffer Pose { vec4 pose[]; };
layout(std430, binding = 6) readonly buffer HeadingB { float headingRad[]; };
layout(std430, binding = 7) readonly buffer Motion { vec4 motion[]; };
layout(std430, binding = 8) readonly buffer Filter { uint filter_[]; };
layout(std430, binding = 9) readonly buffer Overlap { uint overlap[]; };
layout(std430, binding = 10) writeonly buffer CarViews { CarViewRow carViews[]; };
layout(std430, binding = 11) writeonly buffer WalkerViews { WalkerViewRow walkerViews[]; };

// The covers kernel's counts (DeviceWorld._counts) and where the host reads them, and the ground's ring of marks the tyre
// pass laid the step's into.
layout(std430, binding = 12) readonly buffer CoverCounts { uint coverCounts[4]; };

#include "world/terrain/kernels/drift_mark_rows.glsl"

layout(std430, binding = 13) buffer DriftMarkRingB { DriftMarkRing driftMarkRing; };
layout(std430, binding = 14) writeonly buffer CountsOut { uint countsOut[4]; };

#define DRIFT_MARK_RING driftMarkRing
#include "world/terrain/kernels/drift_marks.glsl"

// What each car follows (world_signals.comp), its build, and the lanes it is read along (line_reading.glsl).
#include "agents/car/body/kernels/car_build.glsl"
#include "world/road/kernels/line_followed.glsl"
layout(std430, binding = 15) buffer Follows { LineFollowedRow follows[]; };
layout(std430, binding = 16) readonly buffer Builds { CarBuildRow builds[]; };
layout(std430, binding = 17) readonly buffer BuildOf { uint buildOf[]; };

#define LINE_READING_BINDING 18
#include "world/road/kernels/line_reading.glsl"

void viewTheCar(uint car, bool stepped)
{
    WorldCar row = cars[car];
    int body = row.body;
    vec4 placed = pose[body];
    vec4 moving = motion[body];
    float heading = headingRad[body];
    vec2 forward = placed.zw;
    uint filtered = filter_[body];
    bool frozen = (filtered & world.frozenBit) != 0u;

    bool frozenBefore = (row.flags & CarFrozenBefore) != 0u;
    if (stepped)
    {
        vec2 spentNs = vec2(0.0);
        for (uint wheel = 0u; wheel < 4u; wheel++) spentNs += impulseRows[car * 4u + wheel].xy;

        precise float perMps2 = row.massKg * world.dtS;
        vec2 heldMps2 = roundedQuotient(spentNs, perMps2);
        precise float alongMps2 = heldMps2.x * forward.x + heldMps2.y * forward.y;
        precise float acrossMps2 = heldMps2.x * -forward.y + heldMps2.y * forward.x;
        precise float keep = 1.0 - world.loadSettledShare;
        precise vec2 towardMps2 = vec2(alongMps2, acrossMps2) * world.loadSettledShare;
        precise vec2 settledMps2 = fma(poses[car].accelerationMps2, vec2(keep), towardMps2);
        settledMps2 = mix(settledMps2, vec2(0.0), lessThan(abs(settledMps2), vec2(world.leastSettledLoadMps2)));
        poses[car] = TyrePose(placed.xy, moving.xy, forward, settledMps2, heading, moving.z, row.massKg, 0.0);

        frozenBefore = (row.flags & CarFrozenNext) != 0u;
        cars[car].flags = (row.flags & ~(CarFrozenBefore | CarFrozenNext)) | (frozenBefore ? CarFrozenBefore : 0u)
                          | (frozen ? CarFrozenNext : 0u);
    }

    uint flags = (frozen ? ViewFrozen : 0u) | (frozen && frozenBefore ? ViewFrozenThroughLastStep : 0u)
                 | (carRows[car].flags & 0xf00u) | (filterChannels(filtered) << 16);
    // Where the rear axle stands on what the car follows (LineReading), read on from where the last step's view read it;
    // a view written again off the clock reads around the same place, and answers the same.
    LineFollowedRow followed = follows[car];
    if (stepped && !isnan(followed.progressM)) followed.aroundM = followed.progressM;
    CarBuildRow build = builds[buildOf[car]];
    precise vec2 rearAxleM = placed.xy - forward * build.centreAheadOfAxleM;
    lineRead(followed, rearAxleM, build.projectionWindowM);
    follows[car] = followed;

    carViews[car] = CarViewRow(
        placed.xy, moving.xy, heading, moving.z, flags, uintBitsToFloat(overlap[body]), forward, followed.progressM,
        followed.offLineM, followed.serial, 0u);
}

void viewTheWalker(uint walker, bool stepped)
{
    WorldWalker row = walkers[walker];
    int body = row.body;
    vec2 velocityMps = motion[body].xy;

    // What its gait is drawn off: the step's own travel, which is its velocity over the step (PersonFleet.DistanceWalkedM).
    if (stepped && (row.flags & WalkerInside) == 0u)
    {
        walkers[walker].distanceWalkedM = row.distanceWalkedM + length(velocityMps) * world.dtS;
    }

    uint flags = any(notEqual(row.declaredMps, vec2(0.0))) ? ViewDeclares : 0u;
    walkerViews[walker] = WalkerViewRow(
        pose[body].xy, velocityMps, row.headingRad, flags, uintBitsToFloat(overlap[body]), 0);
}

void main()
{
    uint at = gl_GlobalInvocationID.x;
    bool stepped = (world.mode & ViewStepped) != 0u;
    if (at == 0u)
    {
        for (uint count = 0u; count < 4u; count++) countsOut[count] = coverCounts[count];
        if (stepped) driftMarksSettle();
    }

    if (at >= world.count) return;

    if (at < world.carCount) viewTheCar(at, stepped);
    else viewTheWalker(at - world.carCount, stepped);
}
