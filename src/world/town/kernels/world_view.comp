#version 460
#extension GL_GOOGLE_include_directive : require

// The cars' half of the shallow state handed back behind every step (WorldView; ManagedWorld.WriteTheView), one thread a
// car, written straight into memory the host reads: whether it is frozen and whether it was through the whole step,
// which wheels stand on a way, its channels and how deep it was into what it touched, where it stands on what it follows
// and where its wheel is aimed. The walkers' half, the covers' counts and the marks are world_view_walkers.comp's — two
// passes, since one would bind more storage buffers than WebGPU gives a kernel.
//
// With ViewStepped in the mode the pass is the step's own and keeps what the step settled — the acceleration a car
// settles onto its springs with, lagged toward what its patches spent this tick — and each car's pose as its tyres read
// it at the next step, and whether it comes into that step frozen, until a signal moves its body (world_signals.comp).
// Without it (the view written again off the clock, DeviceWorld.ReadCovers) it only reads, so a second pass moves nothing.

layout(local_size_x = 64) in;

#include "world/town/kernels/world.glsl"
#include "agents/car/body/kernels/tyre_rows.glsl"
#include "core/geometry/kernels/rounded.glsl"
#include "world/physics/kernels/filter.glsl"

layout(std430, binding = 0) buffer Cars { WorldCar cars[]; };
layout(std430, binding = 1) readonly buffer ImpulseRows { vec4 impulseRows[]; };
layout(std430, binding = 2) buffer Poses { TyrePose poses[]; };
layout(std430, binding = 3) readonly buffer CarRows { TyreCarRow carRows[]; };
layout(std430, binding = 4) readonly buffer Pose { vec4 pose[]; };
layout(std430, binding = 5) readonly buffer HeadingB { float headingRad[]; };
layout(std430, binding = 6) readonly buffer Motion { vec4 motion[]; };
layout(std430, binding = 7) readonly buffer Filter { uint filter_[]; };
layout(std430, binding = 8) readonly buffer Overlap { uint overlap[]; };
layout(std430, binding = 9) writeonly buffer CarViews { CarViewRow carViews[]; };

// What each car follows (world_signals.comp), its build, and the lanes it is read along (line_reading.glsl).
#include "agents/car/body/kernels/car_build.glsl"
#include "world/road/kernels/line_followed.glsl"
layout(std430, binding = 10) buffer Follows { LineFollowedRow follows[]; };
layout(std430, binding = 11) readonly buffer Builds { CarBuildRow builds[]; };
layout(std430, binding = 12) readonly buffer BuildOf { uint buildOf[]; };

#define LINE_READING_BINDING 13
#include "world/road/kernels/line_reading.glsl"

void main()
{
    uint car = gl_GlobalInvocationID.x;
    if (car >= world.count) return;

    bool stepped = (world.mode & ViewStepped) != 0u;
    WorldCar row = cars[car];
    int body = row.body;
    vec4 placed = pose[body];
    vec4 moving = motion[body];
    float heading = headingRad[body];
    vec2 forward = placed.zw;
    uint filtered = filter_[body];
    bool frozen = (filtered & world.frozenBit) != 0u;

    bool frozenBefore = (row.flags & CarFrozenBefore) != 0u;
    if (stepped)
    {
        vec2 spentNs = vec2(0.0);
        for (uint wheel = 0u; wheel < 4u; wheel++) spentNs += impulseRows[car * 4u + wheel].xy;

        precise float perMps2 = row.massKg * world.dtS;
        vec2 heldMps2 = roundedQuotient(spentNs, perMps2);
        precise float alongMps2 = heldMps2.x * forward.x + heldMps2.y * forward.y;
        precise float acrossMps2 = heldMps2.x * -forward.y + heldMps2.y * forward.x;
        precise float keep = 1.0 - world.loadSettledShare;
        precise vec2 towardMps2 = vec2(alongMps2, acrossMps2) * world.loadSettledShare;
        precise vec2 settledMps2 = fma(poses[car].accelerationMps2, vec2(keep), towardMps2);
        settledMps2 = mix(settledMps2, vec2(0.0), lessThan(abs(settledMps2), vec2(world.leastSettledLoadMps2)));
        poses[car] = TyrePose(placed.xy, moving.xy, forward, settledMps2, heading, moving.z, row.massKg, 0.0);

        frozenBefore = (row.flags & CarFrozenNext) != 0u;
        cars[car].flags = (row.flags & ~(CarFrozenBefore | CarFrozenNext)) | (frozenBefore ? CarFrozenBefore : 0u)
                          | (frozen ? CarFrozenNext : 0u);
    }

    uint flags = (frozen ? ViewFrozen : 0u) | (frozen && frozenBefore ? ViewFrozenThroughLastStep : 0u)
                 | (carRows[car].flags & 0xf00u) | (filterChannels(filtered) << 16);
    // Where the rear axle stands on what the car follows (LineReading), read on from where the last step's view read it;
    // a view written again off the clock reads around the same place, and answers the same.
    LineFollowedRow followed = follows[car];
    if (stepped && !floatIsNaN(followed.progressM)) followed.aroundM = followed.progressM;
    CarBuildRow build = builds[buildOf[car]];
    precise vec2 rearAxleM = placed.xy - forward * build.centreAheadOfAxleM;
    lineRead(followed, rearAxleM, build.projectionWindowM);
    follows[car] = followed;

    // What the wheel is aimed at (LineReading.Lead): a lookahead at the speed along the car's own way (CarFollower.LookaheadM),
    // and the wheel pure pursuit asks for through it (CarFollower.AimAt: PursuitBend, SteerFor).
    precise float alongMps = moving.x * forward.x + moving.y * forward.y;
    precise float timedM = abs(alongMps) * world.lookaheadS;
    float leadAtM;
    vec2 leadM = lineLead(followed, lineClamp(timedM, build.lookaheadFloorM, build.lookaheadCeilingM), leadAtM);
    float aimRad = 0.0;
    if (!floatIsNaN(leadAtM))
    {
        precise vec2 toLead = leadM - rearAxleM;
        float reachM = roundedLength(toLead);
        float bend = 0.0;
        if (!(reachM < 1e-3))
        {
            precise float twiceSin = 2.0 * lineCross(forward, toLead);
            precise float reachSq = reachM * reachM;
            bend = roundedQuotient(twiceSin, reachSq);
        }

        precise float wheel = bend * build.wheelbaseM;
        aimRad = lineClamp(trigAtan(wheel), -build.maxSteerRad, build.maxSteerRad);
    }

    carViews[car] = CarViewRow(
        placed.xy, moving.xy, heading, moving.z, flags, uintBitsToFloat(overlap[body]), forward, followed.progressM,
        followed.offLineM, followed.serial, leadAtM, aimRad, 0u);
}
