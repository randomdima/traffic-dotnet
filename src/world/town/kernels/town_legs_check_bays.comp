#version 460
#extension GL_GOOGLE_include_directive : require

// The leg's small probes (town_legs_check.glsl), the one its push names: whether a decision would be the clock alone
// (TakesOnlyTheClock), the free bay near each car (FreeBayNear, on any side and on the side of where it is going), the
// register's claims and releases (ParkingRegistry.Claim, Release), and the lane nearest each car (RoadGraph.NearestLane,
// NearestStreetLane).

#include "world/town/kernels/town_legs_check.glsl"

const uint ProbeTheClockAlone = 2u;
const uint ProbeFree = 4u;
const uint ProbeClaimed = 5u;

void main()
{
    for (uint row = 0u; row < push.count; row++)
    {
        reached = 0u;
        uint car = uint(listedCar(row));
        vec2 atM = cars_PositionM(car);
        if (push.probe == ProbeTheClockAlone)
        {
            put(row, 29u, town_TakesOnlyTheClock(car, push.sinceLastDecisionS));
            put(row, 16u, reached);
        }
        else if (push.probe == ProbeFree)
        {
            put(row, 29u, town_FreeBayNear(atM, legsFigures.personWalkWorthM));
            put(row, 30u, town_FreeBayNearSide(atM, legsFigures.personWalkWorthM, cars_DestinationM(car)));
        }
        else if (push.probe == ProbeClaimed)
        {
            put(row, 29u, parking_Claim(car, listedArgument(row)));
        }
        else
        {
            float alongM;
            put(row, 29u, roads_NearestLane(atM, alongM));
            put(row, 30u, alongM);
            put(row, 31u, roads_NearestStreetLaneOn(atM, cars_LevelOf(car), alongM));
            put(row, 0u, alongM);
        }
    }

    // A claim walk gives back every second car's claim after them all, and reads the register as it stands.
    if (push.probe == ProbeClaimed)
    {
        for (uint row = 1u; row < push.count; row += 2u) parking_Release(uint(listedCar(row)));

        for (uint row = 0u; row < push.count; row++)
        {
            put(row, 20u, parking_ClaimedBayOfCar(uint(listedCar(row))));
            put(row, 1u, parking_ClaimedBy(listedArgument(row)));
        }
    }

    putTheCounts();
}
