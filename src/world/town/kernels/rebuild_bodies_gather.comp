#version 460
#extension GL_GOOGLE_include_directive : require

// Every unit's pieces named as candidates from where its scan says, in the order the unit laid them, and each piece
// the host lays counted onto its way, one thread a unit (rebuild_bodies.glsl).

layout(local_size_x = 64) in;

layout(push_constant) uniform Figures
{
    uint walkerCount;
    uint carCount;
    uint wayCount;
    uint coverRoom;
    uint carRoom;
} figures;

#include "world/town/kernels/rebuild_bodies.glsl"

void main()
{
    uint unit = gl_GlobalInvocationID.x;
    if (unit >= bodiesUnitCount()) return;

    uint first = unitCandidates[unit];
    uint pieces = bodiesPiecesOf(unit);
    for (uint piece = 0u; piece < pieces; piece++)
    {
        uint ref = bodiesRefOf(unit, piece);
        candidateRefs[first + piece] = ref;
        ClaimRow laid = bodiesCandidate(ref);
        if (!bodiesRefused(laid)) atomicAdd(wayCounts[laid.way], 1u);
    }
}
