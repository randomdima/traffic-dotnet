#version 460
#extension GL_GOOGLE_include_directive : require

// One table read and another written through the root alone (town_root.glsl): what every resident kernel stands on,
// asked of itself — each value of the first table doubled into the second.

#include "world/town/kernels/town_root.glsl"

layout(local_size_x = 64) in;

layout(push_constant) uniform Push
{
    uint count;
    uint fromId;
    uint intoId;
} push;

void main()
{
    uint at = gl_GlobalInvocationID.x;
    if (at >= push.count) return;

    TOWN(Floats, push.intoId).v[at] = 2.0 * TOWN(Floats, push.fromId).v[at];
}
