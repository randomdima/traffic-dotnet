#version 460
#extension GL_GOOGLE_include_directive : require

// The walkers' decisions put off a tick, asked at the head of the next tick's submit (walker_decide.glsl), one thread a
// walker named in the list due: each one's verdict where the host reads it, its clock run where that is the whole of its
// decision, and where it is not, its clock as it stood written into the host's memory — everything else of it the town
// holds as the kept table does, or the town decides it whole (DecideByTheTown).
//
// Past the list, one thread a walker of the table (findCount): every walker whose decision the device finds itself
// (decidesItself) and whose turn it was, the host naming none — those more than their clock named in a list where it
// reads them.

layout(local_size_x = 64) in;

#include "world/town/kernels/walkers_buffers.glsl"
#include "world/town/kernels/walker_table.glsl"

// app/devicetick/DeviceWalkers.DecideFigures: the tick's stamp and how many are due, and the figures the host's own
// decision reads, as the host has them.
struct WalkerDecideFigures
{
    uint stamp;
    uint count;
    float wayInReachM;
    float walksBeforeTheNextM;
    float byM;
    float patienceS;
    float sinceLastDecisionS;
    float lostOffM;
    uint checks;

    // The walkers whose decisions are found past the list, their decisions' tick modulo their groups and the groups
    // (TickGroups), and whether every one found is the town's whatever the device finds.
    uint findCount;
    uint dueTick;
    uint groups;
    uint foundByTheTown;
    uint pad0;
    uint pad1;
    uint pad2;
};

layout(std430, binding = 23) readonly buffer DecideFigures { WalkerDecideFigures DECIDE; };

#include "agents/person/actions/kernels/walker_decide.glsl"

// A walker due, and in the top bit whether the town decides it whole whatever is found.
const uint DecideByTheTown = 0x80000000u;

// What a walker whose decision is more than its clock is decided on: its clock as it stood, and the route slot it was
// last run or laid at.
struct WalkerClockOut
{
    float sinceS;
    float closestM;
    uint stamp;
    int routeTakenAt;
};

layout(std430, binding = 24) readonly buffer DecideList { uint decideList[]; };
layout(std430, binding = 25) readonly buffer TickTable { WalkerTableRow tickRows[]; };
layout(std430, binding = 26) readonly buffer ReadersHolds { WalkerReadersHold readersHolds[]; };
layout(std430, binding = 27) buffer Clocks { WalkerClock clocks[]; };
layout(std430, binding = 28) writeonly buffer Verdicts { uint verdicts[]; };
layout(std430, binding = 29) writeonly buffer DecideOut { WalkerClockOut decideOut[]; };

#include "world/town/kernels/walker_out.glsl"

// And its kept row, for the town to take up where it left the walker on the device (DeviceWalkers.LeftOnTheDevice).
layout(std430, binding = 30) writeonly buffer DecideRows { WalkerOut decideRows[]; };

// Which walkers' decisions the device finds itself, a bit a walker (app/devicetick/DeviceWalkers.DecidesItself); how many
// of those due it found more than their clock and how many its clock alone; and the first, in the host's memory.
layout(std430, binding = 31) readonly buffer DecidesItself { uint decidesItself[]; };
layout(std430, binding = 32) buffer FoundCounts { uint foundMore; uint foundClockAlone; };
layout(std430, binding = 33) writeonly buffer FoundMore { uint foundWalkers[]; };

bool decideOne(uint walker, bool byTheTown);

void main()
{
    uint at = gl_GlobalInvocationID.x;
    if (at < DECIDE.count)
    {
        uint entry = decideList[at];
        decideOne(entry & ~DecideByTheTown, (entry & DecideByTheTown) != 0u);
        return;
    }

    // TickGroups.Turn, of the walker's agent: walkers come first in the roster.
    uint walker = at - DECIDE.count;
    if (walker >= DECIDE.findCount || (decidesItself[walker >> 5u] & (1u << (walker & 31u))) == 0u) return;
    if (DECIDE.groups > 1u && (DECIDE.dueTick + walker) % DECIDE.groups != 0u) return;

    if (decideOne(walker, DECIDE.foundByTheTown != 0u)) foundWalkers[atomicAdd(foundMore, 1u)] = walker;
    else atomicAdd(foundClockAlone, 1u);
}

// One walker's decision put off, and whether it was more than its clock.
bool decideOne(uint walker, bool byTheTown)
{
    WalkerRow row = walkers[walker];
    WalkerClock clock = clocks[walker];

    // A rebuild walked it on to another way: its clock restarted, as the town's taking that up restarts it.
    if (!byTheTown && row.routeTaken != clock.routeTakenAt) clock = decideRestarted(row);

    WalkerClock asked = clock;
    bool more = byTheTown || decideWalkerMoreThanTheClock(row, walker, tickRows[walker].positionM, readersHolds[walker], clock);
    verdicts[walker] = (DECIDE.stamp << 1u) | (more ? 1u : 0u);
    if (!more) clocks[walker] = clock;

    // Checked, every clock a decision was asked with goes back, for the town to ask its own of it.
    if (more || DECIDE.checks != 0u)
    {
        decideOut[walker] = WalkerClockOut(asked.sinceS, asked.closestM, DECIDE.stamp, asked.routeTakenAt);
        decideRows[walker] = walkerOutOf(row, walker);
    }

    return more;
}
