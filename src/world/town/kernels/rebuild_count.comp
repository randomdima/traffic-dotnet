#version 460
#extension GL_GOOGLE_include_directive : require

// How many rows and holds each unit of the plans lays, one thread a unit, for the scans that number them
// (rebuild_plans.glsl) — and the most any car's plan and any walker's walk laid, for the tally to hold to their rooms.

layout(local_size_x = 64) in;

layout(push_constant) uniform Figures
{
    uint stretchCount;
    uint carCount;
    uint walkerCount;
    uint mostPieces;
    float standOffM;
} figures;

#include "world/town/kernels/rebuild_plans.glsl"

void main()
{
    uint unit = gl_GlobalInvocationID.x;
    if (unit >= plansUnitCount()) return;

    uvec2 laid = plansCountOf(unit);
    unitRows[unit] = laid.x;
    unitHolds[unit] = laid.y;
    if (unit >= plansFirstWalker()) atomicMax(tally[TallyMostProposed], laid.x);
    else if (unit >= plansFirstCar() && (carClaims[unit - plansFirstCar()].flags & CarPlansOnTheDevice) != 0u) atomicMax(tally[TallyMostPieces], laid.x);
}
