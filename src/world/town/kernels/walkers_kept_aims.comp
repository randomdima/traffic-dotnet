#version 460
#extension GL_GOOGLE_include_directive : require

// Where each walker the last rebuild's stages changed is aimed and whether it walks (walkers_kept_out.comp's rows), written
// where its next tick reads them (walker_table.glsl), one thread a row — in that tick's own submit, after the town's
// walkers written whole over the table, which a rebuild the town has not yet taken back left with the aims before it.

layout(local_size_x = 64) in;

layout(push_constant) uniform Figures
{
    uint walkerCount;
} figures;

#include "agents/person/actions/kernels/walker_rows.glsl"
#include "world/town/kernels/walker_table.glsl"
#include "world/town/kernels/walker_out.glsl"

layout(std430, binding = 0) readonly buffer Out { WalkerOut rowsOut[]; };
layout(std430, binding = 1) readonly buffer OutCount { uint outCount; };
layout(std430, binding = 2) buffer Table { WalkerTableRow table[]; };

void main()
{
    uint at = gl_GlobalInvocationID.x;
    if (at >= figures.walkerCount || at >= outCount) return;

    WalkerOut row = rowsOut[at];
    table[row.walker].aimM = row.destinationM;
    uint walking = (row.flags & WalkerWalking) != 0u ? WalkerTableWalking : 0u;
    table[row.walker].flags = (table[row.walker].flags & ~WalkerTableWalking) | walking;
}
