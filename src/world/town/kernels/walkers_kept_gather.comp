#version 460
#extension GL_GOOGLE_include_directive : require

// Every walker a device keeps for its rebuilds (app/devicetick/DeviceWalkers' kept table) read in where the bodies' step
// left it, one thread a walker: its place, the pace its tick declared and how fast it is going the way it faces, off the
// walker tick's own table (walker_table.glsl), and nothing yet done to it. Written as the row stands before the rebuild's
// stages too, which is what walkers_kept_out.comp tells their work from.

layout(local_size_x = 64) in;

layout(push_constant) uniform Figures
{
    uint walkerCount;
} figures;

#include "agents/person/actions/kernels/walker_rows.glsl"
#include "world/town/kernels/walker_table.glsl"

layout(std430, binding = 0) buffer Kept { WalkerRow kept[]; };
layout(std430, binding = 1) writeonly buffer Before { WalkerRow before[]; };
layout(std430, binding = 2) readonly buffer Table { WalkerTableRow table[]; };

void main()
{
    uint walker = gl_GlobalInvocationID.x;
    if (walker >= figures.walkerCount) return;

    WalkerRow row = kept[walker];
    WalkerTableRow ticked = table[walker];
    row.positionM = ticked.positionM;
    row.declaredMps = ticked.declaredMps;

    // WalkingGround.AlongItsWalkMps, off the device's own heading.
    precise vec2 facing = vec2(cos(ticked.headingRad), sin(ticked.headingRad));
    precise float alongMps = ticked.velocityMps.x * facing.x + ticked.velocityMps.y * facing.y;
    row.alongMps = alongMps;
    row.events = 0u;
    kept[walker] = row;
    before[walker] = row;
}
