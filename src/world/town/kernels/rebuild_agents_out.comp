#version 460
#extension GL_GOOGLE_include_directive : require

// What a rebuild handed back to the town says of each car and each walker, packed one row each, one thread an agent: a
// car's plan (DrivingGround.ClearTheClaim's claimFromM; Following.Plan's claimToM, committedToM, horizonM), whether it
// laid a hold, whether a body stands inside its pass, the channels its body is on and which of its wheels stand on a way;
// and whether a walker's walk laid a hold and committed it to a straight, and what that hold came to
// (WalkingGround.ReadTheGrant's reading of it). Which wheels stand on a way goes into the car's tyre row too, which the
// next tyre pass grips by (CarFleet.WheelsOnAWay, TER-7b).

layout(local_size_x = 64) in;

layout(push_constant) uniform Figures
{
    uint carCount;
    uint walkerCount;
    uint firstWalkerUnit;
} figures;

#include "world/road/kernels/claims_rows.glsl"
#include "agents/car/actions/follow/kernels/plan_rows.glsl"
#include "agents/car/body/kernels/tyre_rows.glsl"

// app/devicetick/DeviceRebuild.CarOut, field for field.
struct CarOut
{
    float claimFromM;
    float claimToM;
    float committedToM;
    float horizonM;
    uint bits;
};

// app/devicetick/DeviceRebuild.WalkOut, field for field: where the walker's hold ended, what it keeps off what cut it, and
// the way it was cut on — infinity, nothing and none where it laid no hold.
struct WalkOut
{
    uint bits;
    float endsAtM;
    float marginM;
    int cutOn;
};

const uint CarLaidAHold = 1u;
const uint CarHeldInItsPass = 2u;
const uint CarChannelsShift = 8u;
const uint CarWheelsShift = 16u;

const uint WalkerLaidAHold = 1u;
const uint WalkerCommittedAStraight = 2u;

layout(std430, binding = 0) readonly buffer PlanResults { PlanOutRow planResults[]; };
layout(std430, binding = 1) readonly buffer AskAnswers { uvec4 askAnswers[]; };
layout(std430, binding = 2) readonly buffer CarCounts { uvec4 carCounts[]; };
layout(std430, binding = 3) writeonly buffer CarsOut { CarOut carsOut[]; };
layout(std430, binding = 4) readonly buffer WalkerCounts { uvec4 walkerCounts[]; };
layout(std430, binding = 5) writeonly buffer WalkersOut { WalkOut walkersOut[]; };
layout(std430, binding = 6) readonly buffer UnitHolds { uint unitHolds[]; };
layout(std430, binding = 7) readonly buffer Answers { ClaimAnswer answers[]; };
layout(std430, binding = 8) buffer TyreCars { TyreCarRow tyreCars[]; };

// DeviceTyres.CarRow.FlagsOf: which wheels stand on a way, from bit 8.
const uint TyreWheelsShift = 8u;
const uint TyreWheelsBits = 0xff00u;

void main()
{
    uint agent = gl_GlobalInvocationID.x;
    if (agent < figures.carCount)
    {
        PlanOutRow plan = planResults[agent];
        uint wheels = carCounts[agent].w;
        uint bits = (plan.laidAHold != 0u ? CarLaidAHold : 0u) | (askAnswers[agent].x != 0u ? CarHeldInItsPass : 0u)
                    | (carCounts[agent].y << CarChannelsShift) | (wheels << CarWheelsShift);
        carsOut[agent] = CarOut(plan.claimFromM, plan.claimToM, plan.committedToM, plan.horizonM, bits);
        tyreCars[agent].flags = (tyreCars[agent].flags & ~TyreWheelsBits) | (wheels << TyreWheelsShift);
    }

    if (agent < figures.walkerCount)
    {
        uvec4 walk = walkerCounts[agent];
        WalkOut out_ = WalkOut(walk.y != 0u ? WalkerCommittedAStraight : 0u, uintBitsToFloat(0x7f800000u), 0.0, -1);
        if (walk.x != 0u)
        {
            ClaimAnswer answer = answers[unitHolds[figures.firstWalkerUnit + agent]];
            out_.bits |= WalkerLaidAHold;
            out_.endsAtM = answer.cutLineM;
            out_.marginM = answer.marginM;
            out_.cutOn = answer.cutOn;
        }

        walkersOut[agent] = out_;
    }
}
