#version 460
#extension GL_GOOGLE_include_directive : require

// The town's state headers asked of themselves (app/devicetick/TownState): every header included, so they compile
// together, and a probe a dispatch — some of each module's fields read through their accessors, a stream drawn from, or
// a map query asked — written as words, ProbeWords a thread, into the table outId names.

#include "world/town/kernels/town_cars.glsl"
#include "world/town/kernels/town_people.glsl"
#include "world/town/kernels/town_places.glsl"
#include "world/town/kernels/town_errands.glsl"
#include "world/town/kernels/town_map.glsl"
#include "world/town/kernels/town_map_queries.glsl"
#include "world/town/kernels/town_car_actions.glsl"
#include "world/town/kernels/town_walker_actions.glsl"

layout(local_size_x = 64) in;

layout(push_constant) uniform Push
{
    uint probe;
    uint count;
    uint outId;
} push;

const uint ProbeWords = 8u;

const uint ProbeCars = 0u;
const uint ProbePeople = 1u;
const uint ProbeBays = 2u;
const uint ProbeErrands = 3u;
const uint ProbeLanes = 4u;
const uint ProbeCarActions = 5u;
const uint ProbeWalkerActions = 6u;
const uint ProbeDraws = 7u;
const uint ProbeConnectorBetween = 8u;
const uint ProbeReachesBySwitching = 9u;
const uint ProbePieceAt = 10u;
const uint ProbeNearestDoor = 11u;

void put(uint at, uint word, uint value) { TOWN(Uints, push.outId).v[ProbeWords * at + word] = value; }
void put(uint at, uint word, int value) { put(at, word, uint(value)); }
void put(uint at, uint word, float value) { put(at, word, floatBitsToUint(value)); }

// The first lane a lane's connectors reach, or none.
int firstOnward(int lane)
{
    return roads_ConnectorAt(lane) < roads_ConnectorAt(lane + 1) ? roads_ConnectorToLane(roads_ConnectorAt(lane)) : RoadGraphNoLane;
}

void main()
{
    uint at = gl_GlobalInvocationID.x;
    if (at >= push.count) return;

    int i = int(at);
    if (push.probe == ProbeCars)
    {
        put(at, 0u, cars_Action(at));
        put(at, 1u, cars_RouteLane(at, CarFleetRouteLanesPerCar - 1u));
        put(at, 2u, cars_Owner(at));
        put(at, 3u, cars_DestinationM(at).y);
        put(at, 4u, town_AsksTheRoute(at));
        put(at, 5u, standing_Entries(at));
        put(at, 6u, cars_BackRoomM(at));
        put(at, 7u, (town_WreckedWord(at >> 5u) >> (at & 31u)) & 1u);
    }
    else if (push.probe == ProbePeople)
    {
        put(at, 0u, people_TimerS(at));
        put(at, 1u, people_Inside(at).kind);
        put(at, 2u, people_Inside(at).index);
        put(at, 3u, people_Variant(at));
        put(at, 4u, people_DestinationBuilding(at));
        put(at, 5u, people_Manual(at));
        put(at, 6u, (town_WoundedWord(at >> 5u) >> (at & 31u)) & 1u);
    }
    else if (push.probe == ProbeBays)
    {
        put(at, 0u, parking_CarInBay(at));
        put(at, 1u, parking_CentreM(at).x);
        put(at, 2u, parking_HeldFor(at));
        put(at, 3u, bayStreets_SlotLane(at, 1u));
        put(at, 4u, bayStreets_AtLaneM(i, bayStreets_SlotLane(at, 0u)));
        put(at, 5u, parking_SpaceWidthM);
        put(at, 6u, parking_BayCount);
    }
    else if (push.probe == ProbeErrands)
    {
        put(at, 0u, recovery_OnTheHookOf(at));
        put(at, 1u, beat_ClosedLane(at, uint(beat_MostLanesClosed) - 1u));
        put(at, 2u, duty_SinceS(at));
        put(at, 3u, carOrders_Kind(at));
        put(at, 4u, containers_CarCrew(at, ContainersCrewSeats - 1u));
        put(at, 5u, round_StoodS(at));
        put(at, 6u, town_ApronStride);
        put(at, 7u, town_Hands.steer);
    }
    else if (push.probe == ProbeLanes)
    {
        put(at, 0u, roads_LaneWidthM(at));
        put(at, 1u, roads_ConnectorAt(at + 1u));
        put(at, 2u, roads_PlaceOfEnd(2u * at + 1u));
        put(at, 3u, driving_LinkOfLane(at));
        put(at, 4u, roads_LaneArcB(roads_LaneArcOffsets(at)).y);
        put(at, 5u, roads_LaneOutward(at));
        put(at, 6u, furniture_StopBarAlongM(at));
        put(at, 7u, roads_LaneCount);
    }
    else if (push.probe == ProbeCarActions)
    {
        put(at, 0u, overtaking_ShapeAsideM(overtaking_Holder(at, OvertakingAtSpeed)));
        put(at, 1u, overtaking_PassedOn(overtaking_Holder(at, OvertakingAtSpeed), OvertakingMostPassedAtOnce - 1u));
        put(at, 2u, switching_SweptCount(at));
        put(at, 3u, switching_SweptRun(at, SwitchingMostRunsOfASwitch - 1u).lastAtM);
        put(at, 4u, manoeuvres_Bay(at));
        put(at, 5u, bayManoeuvring_StandingOf(at).covers);
        put(at, 6u, uint(overtaking_AskedAs(at)));
        put(at, 7u, manoeuvres_ArcB(at, BayManoeuvreMostArcs - 1u).y);
    }
    else if (push.probe == ProbeWalkerActions)
    {
        put(at, 0u, sidestepping_Decided(at).asideM);
        put(at, 1u, sidestepping_AskedRun(at, SidesteppingMostRunsOfAPass - 1u).toM);
        put(at, 2u, sidestepping_PassedOn(at));
        put(at, 3u, walkingGround_StraightStationAtM(at));
        put(at, 4u, sidestepping_WaitedS(at));
        put(at, 5u, uint(sidestepping_Made));
    }
    else if (push.probe == ProbeDraws)
    {
        Rng draw = cars_Draw(at);
        put(at, 0u, rngNextFloat(draw));
        put(at, 1u, rngNextFloat(draw, 0.8, 1.2));
        put(at, 2u, rngNextInt(draw, 7));
        put(at, 3u, rngNextUint(draw));
        put(at, 4u, rngNextInt(draw, 0));
        put(at, 5u, rngNextFloat(draw));
    }
    else if (push.probe == ProbeConnectorBetween)
    {
        put(at, 0u, roads_ConnectorBetween(i, firstOnward(i)));
        put(at, 1u, roads_ConnectorBetween(i, roads_LaneReverse(i)));
        put(at, 2u, roads_ConnectorBetween(i, i));
    }
    else if (push.probe == ProbeReachesBySwitching)
    {
        int beside = roads_LaneBeside(i, true);
        int onto = beside == RoadGraphNoLane ? firstOnward(i) : firstOnward(beside);
        int besideAt;
        put(at, 0u, roads_ReachesBySwitching(i, onto, besideAt) ? 1u : 0u);
        put(at, 1u, besideAt);
        put(at, 2u, onto);
    }
    else if (push.probe == ProbePieceAt)
    {
        float placeM = driving_PlaceOfM(i, 0.5 * roads_LaneLengthM(i));
        float alongPieceM;
        put(at, 0u, placeM);
        put(at, 1u, drivingRuns_PieceAt(driving_LinkOfLane(i), placeM, alongPieceM));
        put(at, 2u, alongPieceM);
    }
    else if (push.probe == ProbeNearestDoor)
    {
        float distanceM;
        put(at, 0u, bucketGrid_Nearest(
            town_Doors, TownDoorsStartsId, TownDoorsCountsId, TownDoorsItemsId, BuildingsEntryPointMId, buildings_CentreM(at), distanceM));
        put(at, 1u, distanceM);
    }
}
