#version 460
#extension GL_GOOGLE_include_directive : require

// How many bodies of its own each unit lays, one thread a unit, for the scan that numbers them (rebuild_bodies.glsl).

layout(local_size_x = 64) in;

layout(push_constant) uniform Figures
{
    uint walkerCount;
    uint carCount;
    uint wayCount;
    uint coverRoom;
    uint carRoom;
} figures;

#include "world/town/kernels/rebuild_bodies.glsl"

void main()
{
    uint unit = gl_GlobalInvocationID.x;
    if (unit >= bodiesUnitCount()) return;

    uint first = unitCandidates[unit];
    uint pieces = bodiesPiecesOf(unit);
    uint bodies = 0u;
    for (uint piece = 0u; piece < pieces; piece++) bodies += firsts[first + piece];
    unitBodies[unit] = bodies;
}
