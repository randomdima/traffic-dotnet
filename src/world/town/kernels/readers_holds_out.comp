#version 460
#extension GL_GOOGLE_include_directive : require

// The holds the town reads this tick, as its readers' layer holds them (app/devicetick/DeviceRebuild.RecordTheHoldsAsked),
// one thread an ask, written into the host's own memory: each hold the town asked for whatever the device decided, and
// each it asked for only where the device found an agent's decision more than its clock and handed it to the town
// (car_decide.glsl's decidedAt, walkers_decide.comp's verdicts, this tick's stamps). Read off the copies the layer's
// landing left on the device, which are what the readers' layer holds: the hold as rebuild_holds_out.comp wrote it and
// the claim that cut it, whole rows copied as words.
//
// Asked of the found (mode), one thread a car or a walker the tick found more than its clock without the host naming it
// (car_tick.comp's ModeFindDue, walkers_decide.comp's): its own hold as the readers' layer numbers it, written where it is.

layout(local_size_x = 64) in;

layout(push_constant) uniform Figures
{
    uint count;
    uint carStamp;
    uint walkerStamp;
    uint stamp;
    uint mode;
} figures;

// Figures.mode: the asks, the cars found, or the walkers found (walkers_decide.comp's).
const uint ModeAsked = 0u;
const uint ModeFound = 1u;
const uint ModeFoundWalkers = 2u;

// A hold number for none (ReadersHoldOf), written for a found car that holds none.
const uint NoHold = 0xffffffffu;

// An ask: the hold, and whose decision it waits on — none, a car's or a walker's.
const uint AskIfDecided = 0x80000000u;
const uint AskOfAWalker = 0x40000000u;
const uint AskAgent = 0x3fffffffu;

// A walker's verdict: the stamp of the tick that wrote it, shifted past whether the decision is more than the clock.
const uint VerdictMore = 1u;

// app/devicetick/DeviceRebuild.HoldAnswered: the hold and the stamp that wrote it, then DeviceRebuild.HoldOut and the
// ClaimRow that cut it, three words of four each.
struct HoldAnswered
{
    uint hold;
    uint stamp;
    uint pad0;
    uint pad1;
    uvec4 held[3];
    uvec4 cutter[3];
};

layout(std430, binding = 0) readonly buffer Asked { uvec2 asked[]; };
layout(std430, binding = 1) readonly buffer ReadersHolds { uvec4 readersHolds[]; };
layout(std430, binding = 2) readonly buffer ReadersCutters { uvec4 readersCutters[]; };
layout(std430, binding = 3) readonly buffer CarsDecidedAt { uint carsDecidedAt[]; };
layout(std430, binding = 4) readonly buffer WalkerVerdicts { uint walkerVerdicts[]; };
layout(std430, binding = 5) writeonly buffer Answered { HoldAnswered answered[]; };

// The cars the tick found more than their clock and how many; each car's hold as the readers' layer numbers it, or -1
// (rebuild_grant.comp's holdOf, copied with the layer); and what came of each found car's, a row a car.
layout(std430, binding = 6) readonly buffer FoundCounts { uint foundMore; uint foundClockAlone; };
layout(std430, binding = 7) readonly buffer FoundMore { uint foundCars[]; };
layout(std430, binding = 8) readonly buffer ReadersHoldOf { int readersHoldOf[]; };
layout(std430, binding = 9) writeonly buffer FoundAnswered { HoldAnswered foundAnswered[]; };

// The same of the walkers found: how many, which, each one's hold as the readers' layer numbers it (walkers_kept_out.comp's
// holdsOut, copied with the layer), and what came of each one's, a row a walker.
layout(std430, binding = 10) readonly buffer WalkersFoundCounts { uint walkersFoundMore; uint walkersFoundClockAlone; };
layout(std430, binding = 11) readonly buffer WalkersFoundMore { uint foundWalkers[]; };
layout(std430, binding = 12) readonly buffer ReadersWalkHoldOf { int readersWalkHoldOf[]; };
layout(std430, binding = 13) writeonly buffer WalkersFoundAnswered { HoldAnswered walkersFoundAnswered[]; };

HoldAnswered answerOf(int hold)
{
    HoldAnswered answer;
    answer.hold = hold < 0 ? NoHold : uint(hold);
    answer.stamp = figures.stamp;
    answer.pad0 = 0u;
    answer.pad1 = 0u;
    for (uint word = 0u; word < 3u; word++)
    {
        answer.held[word] = hold < 0 ? uvec4(0u) : readersHolds[uint(hold) * 3u + word];
        answer.cutter[word] = hold < 0 ? uvec4(0u) : readersCutters[uint(hold) * 3u + word];
    }

    return answer;
}

void main()
{
    uint at = gl_GlobalInvocationID.x;
    if (at >= figures.count) return;

    if (figures.mode == ModeFound)
    {
        if (at < foundMore) foundAnswered[foundCars[at]] = answerOf(readersHoldOf[foundCars[at]]);
        return;
    }

    if (figures.mode == ModeFoundWalkers)
    {
        if (at < walkersFoundMore) walkersFoundAnswered[foundWalkers[at]] = answerOf(readersWalkHoldOf[foundWalkers[at]]);
        return;
    }

    uvec2 ask = asked[at];
    if ((ask.y & AskIfDecided) != 0u)
    {
        uint agent = ask.y & AskAgent;
        bool handed = (ask.y & AskOfAWalker) != 0u
            ? walkerVerdicts[agent] == ((figures.walkerStamp << 1u) | VerdictMore)
            : carsDecidedAt[agent] == figures.carStamp;
        if (!handed) return;
    }

    uint hold = ask.x;
    answered[at].hold = hold;
    for (uint word = 0u; word < 3u; word++)
    {
        answered[at].held[word] = readersHolds[hold * 3u + word];
        answered[at].cutter[word] = readersCutters[hold * 3u + word];
    }

    answered[at].stamp = figures.stamp;
}
