#version 460
#extension GL_GOOGLE_include_directive : require

// What the host still lays itself filed among the device's own, one thread a row or a hold of one numbering's run of the
// host's table: each unit's rows and holds at the slots and holds the device numbered for it, its rows' holds and its
// holds' rows counted from the unit's first rather than the host's (rebuild_rows.glsl's HostUnit) — a hold's own cut
// is the host's, read where it lies.

layout(local_size_x = 64) in;

layout(push_constant) uniform Figures
{
    uint rowFirst;
    uint rowCount;
    uint holdFirst;
    uint holdCount;
    uint firstCarUnit;
    uint carCount;
} figures;

#include "world/road/kernels/claims_rows.glsl"
#include "world/road/kernels/claims_tally.glsl"
#include "world/town/kernels/rebuild_rows.glsl"

layout(std430, binding = 0) readonly buffer HostRows { ClaimRow hostRows[]; };
layout(std430, binding = 1) readonly buffer HostHolds { HoldRow hostHolds[]; };
layout(std430, binding = 2) readonly buffer HostUnits { HostUnit hostUnits[]; };
layout(std430, binding = 3) readonly buffer HostRowUnit { uint hostRowUnit[]; };
layout(std430, binding = 4) readonly buffer HostHoldUnit { uint hostHoldUnit[]; };
layout(std430, binding = 5) readonly buffer UnitRows { uint unitRows[]; };
layout(std430, binding = 6) readonly buffer UnitHolds { uint unitHolds[]; };
layout(std430, binding = 7) writeonly buffer Rows { ClaimRow rows[]; };
layout(std430, binding = 8) writeonly buffer Holds { HoldRow holds[]; };
layout(std430, binding = 9) writeonly buffer Answers { ClaimAnswer answers[]; };
layout(std430, binding = 10) writeonly buffer Shown { float shown[]; };
layout(std430, binding = 11) readonly buffer Tally { uint tally[]; };

// Where a unit's first row and first hold are filed: after the bodies for the passes, and at its own unit among the plans.
uvec2 hostFiledAt(HostUnit unit)
{
    if (unit.numbering == HostPasses) return uvec2(tally[TallyBodies], 0u);
    return uvec2(tally[TallyPassesEnd] + unitRows[unit.unit], unitHolds[unit.unit]);
}

void main()
{
    uint at = gl_GlobalInvocationID.x;
    if (tally[TallyOverflowed] != 0u) return;

    if (at < figures.rowCount)
    {
        uint row = figures.rowFirst + at;
        HostUnit unit = hostUnits[hostRowUnit[row]];
        uvec2 filedAt = hostFiledAt(unit);
        ClaimRow laid = hostRows[row];
        if (laid.hold >= 0) laid.hold = int(filedAt.y) + (laid.hold - unit.hostHoldFirst);
        rows[filedAt.x + (row - unit.rowsAt)] = laid;
        return;
    }

    if (at >= figures.rowCount + figures.holdCount) return;

    uint hold = figures.holdFirst + (at - figures.rowCount);
    HostUnit unit = hostUnits[hostHoldUnit[hold]];
    uvec2 filedAt = hostFiledAt(unit);
    HoldRow held = hostHolds[hold];
    held.firstRow = filedAt.x + uint(int(held.firstRow) - unit.hostSlotFirst);
    held.endRow = filedAt.x + uint(int(held.endRow) - unit.hostSlotFirst);
    uint holdAt = filedAt.y + (hold - unit.holdsAt);
    holds[holdAt] = held;
    answers[holdAt] = rebuildLaidAnswer(held);
    shown[holdAt] = rebuildShownAtFirst(held);
}
