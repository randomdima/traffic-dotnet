#version 460
#extension GL_GOOGLE_include_directive : require

// What the town reads of a car's tick, written into the host's own memory only for the cars it reads (app/devicetick/
// DeviceCarTick.RecordTheOut), one thread a car named in the list taken: a car the host wants this tick, one whose decision
// the device found was more than its clock and the town decides (car_decide.glsl, this tick's stamp), or one whose tick asks
// something of the town — named in the list of those too. Every other car's rows stay on the device. Where the town
// watches every agent, every car's grant left (CarFleet.GrantLeftM) is written besides, a float a car; where the device
// keeps a watch itself, every car as the watch reads it (app/devicetick/DeviceTownWatch.CarRow).

layout(local_size_x = 64) in;

layout(push_constant) uniform Figures
{
    uint carCount;
    uint stamp;
    uint grantsLeft;
    uint watched;
} figures;

#include "agents/car/body/kernels/tyre_rows.glsl"
#include "world/town/kernels/car_tick_rows.glsl"
#include "world/town/kernels/car_watched.glsl"

layout(std430, binding = 0) readonly buffer Taken { uint taken[]; };
layout(std430, binding = 1) readonly buffer Wanted { uint wanted[]; };
layout(std430, binding = 2) readonly buffer Ticks { CarTickRow ticks[]; };
layout(std430, binding = 3) readonly buffer Commands { TyreCommand commands[]; };
layout(std430, binding = 4) readonly buffer Briefs { CarBriefRow briefs[]; };
layout(std430, binding = 5) readonly buffer TyreCars { TyreCarRow tyreCars[]; };
layout(std430, binding = 6) writeonly buffer Out { CarOutRow rows[]; };
layout(std430, binding = 7) writeonly buffer Events { uint events[]; };
layout(std430, binding = 8) buffer EventCount { uint eventCount; };
layout(std430, binding = 9) readonly buffer Clocks { vec2 clocks[]; };
layout(std430, binding = 10) readonly buffer DecidedAt { uint decidedAt[]; };
layout(std430, binding = 11) readonly buffer Grants { CarGrantRow grants[]; };
layout(std430, binding = 12) writeonly buffer GrantsLeft { float grantLeftM[]; };
layout(std430, binding = 13) writeonly buffer Watched { WatchCarRow watched[]; };

void main()
{
    if (gl_GlobalInvocationID.x >= figures.carCount) return;

    uint car = taken[gl_GlobalInvocationID.x];
    CarTickRow tick = ticks[car];
    float leftM = grants[car].authorityM - tick.coveredSinceClaimM;
    if (figures.grantsLeft != 0u) grantLeftM[car] = leftM;

    // A grant nothing cut is infinite, and nothing is past it.
    if (figures.watched != 0u) watched[car] = WatchCarRow(isinf(leftM) || isnan(leftM) ? 0.0 : max(0.0, -leftM), 1u);
    bool asks = (tick.flags & TickEvents) != 0u;
    if (asks) events[atomicAdd(eventCount, 1u)] = car;
    bool decided = decidedAt[car] == figures.stamp;
    if (!asks && !decided && (wanted[car >> 5u] & (1u << (car & 31u))) == 0u) return;

    vec2 clock = clocks[car];
    rows[car] = CarOutRow(tick, commands[car], briefs[car], tyreCars[car], grantOut(grants[car]), clock.x, clock.y, figures.stamp);
}
