#version 460
#extension GL_GOOGLE_include_directive : require

// Every row still on a way filed into its way's run, one thread a row, in whatever order the threads come — the runs
// are sorted after (claims_sort.comp).

layout(local_size_x = 64) in;

layout(push_constant) uniform Figures
{
    uint wayCount;
    uint pad;
} figures;

#include "world/road/kernels/claims_rows.glsl"
#include "world/road/kernels/claims_tally.glsl"
#include "world/road/kernels/claims_lists.glsl"

void main()
{
    uint row = gl_GlobalInvocationID.x;
    if (row >= tally[TallyRows] || claimGone(rows[row])) return;

    order[atomicAdd(cursor[claimsListAt(rows[row])], 1u)] = row;
}
