#version 460
#extension GL_GOOGLE_include_directive : require

// Every car's grant read off what its plan came to, one thread a car (DrivingGround.ReadTheGrant): its hold and where its
// claim began in, its authority, margin and what cut it out.

layout(local_size_x = 64) in;

layout(push_constant) uniform Figures
{
    uint plansHidden;
    uint pass;
    uint carCount;
    uint pad;
} figures;

#include "world/road/kernels/claims_rows.glsl"
#include "world/road/kernels/claims_tally.glsl"
#include "world/road/kernels/claims_buffers.glsl"

// A car's hold this rebuild (or -1) and where its claim begins on its line.
layout(std430, binding = 10) readonly buffer Holders { vec2 holders[]; };
layout(std430, binding = 11) writeonly buffer Grants { vec4 grants[]; };

void main()
{
    uint car = gl_GlobalInvocationID.x;
    if (car >= figures.carCount) return;

    vec2 holder = holders[car];
    int hold = floatBitsToInt(holder.x);
    if (hold < 0 || !claimsAnswered(hold)) return;

    grants[car] = claimsReadTheGrant(answers[hold], holder.y, 0.0, HeadwayNothing);
}
