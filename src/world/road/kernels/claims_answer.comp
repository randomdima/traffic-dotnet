#version 460
#extension GL_GOOGLE_include_directive : require

// One pass of the plans' answers: every hold answered with the plans read against the others as shown the pass
// before, one thread a hold (LaneOccupancy.ShowTheAnswers' first half).

layout(local_size_x = 64) in;

layout(push_constant) uniform Figures
{
    uint plansHidden;
    uint pass;
    uint carCount;
    uint pad;
} figures;

#include "world/road/kernels/claims_rows.glsl"
#include "world/road/kernels/claims_tally.glsl"
#include "world/road/kernels/claims_buffers.glsl"

// Whether a hold has anything new to be answered against this pass (LaneOccupancy.NeedsAnswer): the first pass, or a
// hold that moved last pass on a way one of its pieces is on. Otherwise every end its answer reads is shown where it was,
// and the last pass's answer stands.
bool claimsNeedsAnswer(uint hold)
{
    if (figures.plansHidden != 0u) return true;

    HoldRow held = holds[hold];
    for (uint row = held.firstRow; row < held.endRow; row++)
    {
        if (wayMovedAt[rows[row].way] == figures.pass - 1u) return true;
    }

    return false;
}

void main()
{
    uint hold = gl_GlobalInvocationID.x;
    if (hold >= tally[TallyHolds] || !claimsAnswered(int(hold)) || !claimsNeedsAnswer(hold)) return;

    answers[hold] = claimsAnswer(hold);
}
