#version 460
#extension GL_GOOGLE_include_directive : require

// One pass of the plans' answers shown: every hold answered with the plans shown to where it was answered, the holds
// that moved counted for the pass and the ways of their pieces marked with it (LaneOccupancy.ShowTheAnswers' second
// half).

layout(local_size_x = 64) in;

layout(push_constant) uniform Figures
{
    uint plansHidden;
    uint pass;
    uint carCount;
    uint pad;
} figures;

#include "world/road/kernels/claims_rows.glsl"
#include "world/road/kernels/claims_tally.glsl"
#include "world/road/kernels/claims_buffers.glsl"

void main()
{
    uint hold = gl_GlobalInvocationID.x;
    if (hold >= tally[TallyHolds] || !claimsAnswered(int(hold))) return;

    float cutLineM = answers[hold].cutLineM;
    if (cutLineM == shown[hold]) return;

    shown[hold] = cutLineM;
    atomicAdd(moved[figures.pass], 1u);
    HoldRow held = holds[hold];
    for (uint row = held.firstRow; row < held.endRow; row++) wayMovedAt[rows[row].way] = figures.pass;
}
