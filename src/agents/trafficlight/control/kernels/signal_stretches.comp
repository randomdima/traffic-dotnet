#version 460
#extension GL_GOOGLE_include_directive : require

// A run of lights' stretches each asked its colour at a moment of its own, one thread a stretch, off the service's own
// tables — the cycle asked on its own, which is how its answer is held to the host's.

layout(local_size_x = 64) in;

layout(push_constant) uniform Figures
{
    uint stretchCount;
    uint laneCount;
    uint crossingCount;
    float cycleS;
    float amberTailS;
} figures;

layout(std430, binding = 0) readonly buffer LaneAxis { int laneAxis[]; };
layout(std430, binding = 1) readonly buffer LaneJunction { int laneJunction[]; };
layout(std430, binding = 2) readonly buffer Offsets { float offsetS[]; };
layout(std430, binding = 3) readonly buffer CrossingAxis { int crossingAxis[]; };
layout(std430, binding = 4) readonly buffer CrossingJunction { int crossingJunction[]; };

#define SIGNAL_FIGURES figures
#define SIGNAL_LANE_AXIS laneAxis
#define SIGNAL_LANE_JUNCTION laneJunction
#define SIGNAL_OFFSETS offsetS
#define SIGNAL_CROSSING_AXIS crossingAxis
#define SIGNAL_CROSSING_JUNCTION crossingJunction

#include "agents/trafficlight/control/kernels/signal.glsl"

// A stretch as the holds read it, and the moment it is asked at.
struct StretchRow
{
    int subject;
    uint forCars;
    float timeS;
    float pad;
};

layout(std430, binding = 5) readonly buffer Stretches { StretchRow stretches[]; };
layout(std430, binding = 6) writeonly buffer Colours { uint colours[]; };

void main()
{
    uint stretch = gl_GlobalInvocationID.x;
    if (stretch >= figures.stretchCount) return;

    StretchRow row = stretches[stretch];
    colours[stretch] = signalForStretch(row.subject, row.forCars != 0u, row.timeS);
}
