#version 460
#extension GL_GOOGLE_include_directive : require

// A run of cars' tyres for one tick, one thread a car, off their builds, poses, commands and the ground under their
// wheels — the tyre model asked on its own, which is how the device's answer is held to the host's.

layout(local_size_x = 64) in;

layout(push_constant) uniform Figures
{
    uint carCount;
    float dtS;
    float wheelSpinFadeMps;
    float wheelSpinAllowanceMps;
    float markSlipMps;
    float markCorneringSlipMps;
    float ploughCrawlMps;
    float engineBrakingMps2;
    float workingSlipTangent;
    float alongSlipEpsilonMps;
    float liftedAxleLoadShare;
    float ackermannLeastSteerRad;
    float innerWheelLeastRadiusM;
} figures;

#define TYRE_FIGURES figures
#include "agents/car/body/kernels/car_build.glsl"
#include "agents/car/body/kernels/tyre_rows.glsl"
#include "agents/car/body/kernels/tyre.glsl"
#include "agents/car/body/kernels/suspension.glsl"

layout(std430, binding = 0) readonly buffer Builds { CarBuildRow builds[]; };
layout(std430, binding = 1) readonly buffer BuildOf { uint buildOf[]; };
layout(std430, binding = 2) readonly buffer Poses { TyrePose poses[]; };
layout(std430, binding = 3) readonly buffer Commands { TyreCommand commands[]; };
layout(std430, binding = 4) readonly buffer Ceilings { float ceilings[]; };
layout(std430, binding = 5) readonly buffer Surfaces { TyreSurface surfaces[]; };
layout(std430, binding = 6) buffer Spins { float spins[]; };
layout(std430, binding = 7) writeonly buffer Impulses { vec4 impulses[]; };
layout(std430, binding = 8) writeonly buffer Scrubs { TyreScrub scrubs[]; };

// Every per-wheel row CarMostWheels a car, the car's own wheels first.
void main()
{
    uint car = gl_GlobalInvocationID.x;
    if (car >= figures.carCount) return;

    CarBuildRow build = builds[buildOf[car]];
    int wheels = int(build.wheelCount);
    uint first = car * uint(CarMostWheels);
    TyrePose pose = poses[car];
    vec2 atM[TyreWheels];
    tyreWheelPointsM(build, pose, atM);

    TyreSurface ground[TyreWheels];
    float spinMps[TyreWheels];
    for (int wheel = 0; wheel < TyreWheels; wheel++)
    {
        if (wheel >= wheels) break;

        ground[wheel] = surfaces[first + uint(wheel)];
        spinMps[wheel] = spins[first + uint(wheel)];
    }

    float loadShare[TyreWheels];
    suspensionLoads(build, pose.sprung, 0u, loadShare);
    vec4 spent[TyreWheels];
    TyreScrub scrub[TyreWheels];
    tyreStep(build, pose, commands[car], ceilings[car], loadShare, atM, ground, spinMps, figures.dtS, spent, scrub);

    for (int wheel = 0; wheel < TyreWheels; wheel++)
    {
        if (wheel >= wheels) break;

        spins[first + uint(wheel)] = spinMps[wheel];
        impulses[first + uint(wheel)] = spent[wheel];
        scrubs[first + uint(wheel)] = scrub[wheel];
    }
}
