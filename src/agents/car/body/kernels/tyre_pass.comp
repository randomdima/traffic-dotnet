#version 460
#extension GL_GOOGLE_include_directive : require

// A run of cars' whole tyre pass for one tick, one thread a car (TyrePass.Step), off their builds, poses, commands and
// the state they carry, with which of each car's wheels stood on a way when its body was last laid — and every mark laid
// into the ground's ring of marks where it is drawn from (drift_marks.glsl), and, where a test asks for it, appended as
// a record carrying its car and wheel for the host to file in (car, wheel) order.

layout(local_size_x = 64) in;

struct TyrePassFigures
{
    float dtS;
    float wheelSpinFadeMps;
    float wheelSpinAllowanceMps;
    float markSlipMps;
    float markCorneringSlipMps;
    float ploughCrawlMps;
    float engineBrakingMps2;
    float slipBackOffPerTick;
    float slipRecoverPerTick;
    float minSlipThrottleFraction;
    float tractionThrottleFraction;
    float nominalGripMps2;
    float markOnsetM;
    float markPloughFloor;
    float markSpacingM;
    float workingSlipTangent;
    float alongSlipEpsilonMps;
    float liftedAxleLoadShare;
    float ackermannLeastSteerRad;
    float innerWheelLeastRadiusM;
};

// How many cars, whether each patch's scrub and each mark's record are handed back — a test's question, which the town
// never asks — then the pass's figures (DeviceTyres.PassPush).
layout(push_constant) uniform Pass
{
    uint carCount;
    uint handsBack;
    TyrePassFigures figures;
} pass;

#define TYRE_FIGURES pass.figures
#define TYRE_WHEEL_GROUNDS_BINDING 10

#include "agents/car/body/kernels/car_build.glsl"
#include "agents/car/body/kernels/tyre_rows.glsl"
#include "agents/car/body/kernels/tyre.glsl"
#include "agents/car/body/kernels/tyre_marks.glsl"
#include "agents/car/body/kernels/tyre_pass.glsl"

// One mark laid (DeviceTyres.MarkRow): car × 4 + wheel says whose.
struct TyreMarkRow
{
    vec2 fromM;
    vec2 toM;
    float widthM;
    float intensity;
    uint carWheel;
    uint ploughed;
};

layout(std430, binding = 0) readonly buffer Builds { CarBuildRow builds[]; };
layout(std430, binding = 1) readonly buffer BuildOf { uint buildOf[]; };
layout(std430, binding = 2) readonly buffer Poses { TyrePose poses[]; };
layout(std430, binding = 3) readonly buffer Commands { TyreCommand commands[]; };
layout(std430, binding = 4) buffer CarRows { TyreCarRow carRows[]; };
layout(std430, binding = 5) buffer WheelRows { TyreWheelRow wheelRows[]; };
layout(std430, binding = 6) writeonly buffer ImpulseRows { vec4 impulseRows[]; };
layout(std430, binding = 7) writeonly buffer ScrubRows { TyreScrub scrubRows[]; };
layout(std430, binding = 8) buffer MarkCount { uint markCount; };
layout(std430, binding = 9) writeonly buffer MarkRows { TyreMarkRow markRows[]; };

#include "world/terrain/kernels/drift_mark_rows.glsl"

layout(std430, binding = 11) writeonly buffer DriftMarkRows { DriftMarkRow driftMarkRows[]; };
layout(std430, binding = 12) buffer DriftMarkRingB { DriftMarkRing driftMarkRing; };

#define DRIFT_MARK_ROWS driftMarkRows
#define DRIFT_MARK_RING driftMarkRing
#include "world/terrain/kernels/drift_marks.glsl"

void main()
{
    uint car = gl_GlobalInvocationID.x;
    if (car >= pass.carCount) return;

    TyreCarRow row = carRows[car];
    TyreCarry carry;
    for (int wheel = 0; wheel < TyreWheels; wheel++)
    {
        TyreWheelRow held = wheelRows[car * 4u + uint(wheel)];
        carry.spinMps[wheel] = held.spinMps;
        carry.scrubTravelM[wheel] = held.scrubTravelM;
        carry.markFromM[wheel] = held.markFromM;
        carry.markIntensity[wheel] = held.markIntensity;
        carry.marking[wheel] = held.marking != 0u;
    }

    carry.slipThrottle = row.slipThrottle;
    carry.drivenSlipping = (row.flags & 2u) != 0u;

    // What the pass would leave of a settled car is its rows as they stand and nothing spent, so only that is written.
    TyrePose pose = poses[car];
    TyreCommand command = commands[car];
    if (tyrePassSettled(pose, command, carry))
    {
        carRows[car].flags = row.flags | 4u;
        for (uint at = car * 4u; at < car * 4u + 4u; at++)
        {
            impulseRows[at] = vec4(0.0);
            if (pass.handsBack != 0u) scrubRows[at] = TyreScrub(0.0, 0.0, 0.0, 0u);
        }

        return;
    }

    CarBuildRow build = builds[buildOf[car]];
    vec4 spent[4];
    TyreScrub scrub[4];
    TyreMark laidMarks[4];
    uint laid;
    bool atRest = tyrePass(
        build, pose, command, (row.flags & 1u) != 0u, row.inertiaKgM2, tyreWheelsOnAWayOf(row), pass.figures.dtS,
        carry, spent, scrub, laidMarks, laid);

    carRows[car].slipThrottle = carry.slipThrottle;
    carRows[car].flags = (row.flags & ~6u) | (carry.drivenSlipping ? 2u : 0u) | (atRest ? 4u : 0u);
    for (int wheel = 0; wheel < TyreWheels; wheel++)
    {
        uint at = car * 4u + uint(wheel);
        wheelRows[at] = TyreWheelRow(
            carry.markFromM[wheel], carry.spinMps[wheel], carry.scrubTravelM[wheel], carry.markIntensity[wheel],
            carry.marking[wheel] ? 1u : 0u);
        impulseRows[at] = spent[wheel];
        if (pass.handsBack != 0u) scrubRows[at] = scrub[wheel];
        if ((laid & (1u << uint(wheel))) == 0u) continue;

        TyreMark mark = laidMarks[wheel];
        driftMarkLay(mark.fromM, mark.toM, build.wheelWidthM, mark.intensity, mark.ploughed);
        if (pass.handsBack == 0u) continue;

        uint slot = atomicAdd(markCount, 1u);
        if (slot >= uint(markRows.length())) continue;

        markRows[slot] = TyreMarkRow(mark.fromM, mark.toM, build.wheelWidthM, mark.intensity, at, mark.ploughed ? 1u : 0u);
    }
}
