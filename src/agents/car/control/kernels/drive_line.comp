#version 460
#extension GL_GOOGLE_include_directive : require

// A run of cars each driving its own line for one tick, one thread a car, off the line, the context the host built
// for it, the command it was left at and the pass it is on — the driver asked on its own, which is how its answer is
// held to the host's.

layout(local_size_x = 64) in;

layout(push_constant) uniform Figures
{
    uint carCount;
    float dtS;
    float lookaheadS;
    float gripMargin;
    float brakingMargin;
    float stopSpeedMps;
    float waitingToPassBrakingShare;
    float reactionS;
    float callPaceMps;
    float standardGravityMps2;
    float wheelSpinFadeMps;
    float wheelSpinAllowanceMps;
    float markSlipMps;
    float markCorneringSlipMps;
    float ploughCrawlMps;
    float engineBrakingMps2;
} figures;

#define TYRE_FIGURES figures
#define FOLLOWER_FIGURES figures
#define SPLINE_ARCS lineArcs
#define FOLLOWER_ENTRIES entries

#include "core/geometry/kernels/arc.glsl"
#include "agents/car/body/kernels/car_build.glsl"
#include "agents/car/body/kernels/tyre_rows.glsl"
#include "agents/car/body/kernels/tyre.glsl"

layout(std430, binding = 0) readonly buffer Builds { CarBuildRow builds[]; };
layout(std430, binding = 1) readonly buffer BuildOf { uint buildOf[]; };
layout(std430, binding = 2) readonly buffer Poses { TyrePose poses[]; };
layout(std430, binding = 3) readonly buffer LineArcs { Arc lineArcs[]; };
layout(std430, binding = 4) readonly buffer Entries { float entries[]; };
layout(std430, binding = 5) readonly buffer Lines { uvec4 lines[]; };
layout(std430, binding = 6) readonly buffer LineFigures { vec4 lineFigures[]; };
layout(std430, binding = 7) readonly buffer Travels { vec2 travels[]; };

#include "core/geometry/kernels/arc_chain.glsl"
#include "agents/car/control/kernels/follower.glsl"

layout(std430, binding = 8) readonly buffer Contexts { DriveContextRow contexts[]; };
layout(std430, binding = 9) readonly buffer Lasts { TyreCommand lasts[]; };
layout(std430, binding = 10) writeonly buffer Commands { TyreCommand commands[]; };
layout(std430, binding = 11) writeonly buffer Outcomes { vec4 outcomes[]; };
layout(std430, binding = 12) readonly buffer Passes { OvertakeRow passes[]; };

void main()
{
    uint car = gl_GlobalInvocationID.x;
    if (car >= figures.carCount) return;

    uvec4 line = lines[car];
    vec4 figuresOf = lineFigures[car];
    uint hold;
    float plannedMps;
    bool hazard;
    commands[car] = followDriveTheLine(
        builds[buildOf[car]], poses[car], line.x, line.y, line.x, figuresOf.x, figuresOf.y, contexts[car], travels[car], figuresOf.z,
        (line.z & 1u) != 0u, lasts[car], passes[car], (line.z & 2u) != 0u, (line.z & 4u) != 0u, figuresOf.w, hold, plannedMps,
        hazard);
    outcomes[car] = vec4(float(hold), plannedMps, hazard ? 1.0 : 0.0, 0.0);
}
