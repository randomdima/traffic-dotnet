#version 460
#extension GL_GOOGLE_include_directive : require

// A run of cars each reading the line under it for one tick, one thread a car, over the fleet's own line layout: where
// it is, the lane it has left shifted off, how far off the line it stands and whether the line runs short — the line
// read on its own, which is how its answer is held to the host's.

layout(local_size_x = 64) in;

layout(push_constant) uniform Figures
{
    uint carCount;
    uint arcsPerCar;
    uint mostLanes;
    float roundingM;
} figures;

#define LINE_FIGURES figures
#define SPLINE_ARCS lineArcs
#define LINE_ENTRIES entries
#define LANE_CHAIN chain
#define LANE_START starts
#define LANE_END ends
#define LANE_FIRST_ARC firstArcs
#define JOIN_BREAKS breaks

#include "core/geometry/kernels/arc.glsl"
#include "agents/car/body/kernels/car_build.glsl"
#include "agents/car/control/kernels/car_line.glsl"

// Where the body is and which way it points: the two fields of the tyres' pose this reads.
struct PoseRow
{
    vec2 positionM;
    vec2 forward;
};

layout(std430, binding = 0) readonly buffer Builds { CarBuildRow builds[]; };
layout(std430, binding = 1) readonly buffer BuildOf { uint buildOf[]; };
layout(std430, binding = 2) readonly buffer Poses { PoseRow poses[]; };
layout(std430, binding = 3) readonly buffer Lasts { float lastProgressM[]; };
layout(std430, binding = 4) readonly buffer RunsOn { uint roadRunsOn[]; };
layout(std430, binding = 5) buffer LineArcs { Arc lineArcs[]; };
layout(std430, binding = 6) buffer Entries { float entries[]; };
layout(std430, binding = 7) buffer Chain { int chain[]; };
layout(std430, binding = 8) buffer Starts { float starts[]; };
layout(std430, binding = 9) buffer Ends { float ends[]; };
layout(std430, binding = 10) buffer FirstArcs { uint firstArcs[]; };
layout(std430, binding = 11) buffer Breaks { uint breaks[]; };

#include "core/geometry/kernels/arc_chain.glsl"
#include "agents/car/control/kernels/line.glsl"

layout(std430, binding = 12) buffer Lines { CarLineRow lines[]; };
layout(std430, binding = 13) writeonly buffer Readings { vec4 readings[]; };
layout(std430, binding = 14) writeonly buffer Short { uint runsShort[]; };

void main()
{
    uint car = gl_GlobalInvocationID.x;
    if (car >= figures.carCount) return;

    CarBuildRow build = builds[buildOf[car]];
    PoseRow pose = poses[car];
    precise vec2 rearAxleM = pose.positionM - pose.forward * build.centreAheadOfAxleM;

    CarLineRow line = lines[car];
    LineAdvance advance = lineAdvance(car, build, rearAxleM, lastProgressM[car], line);
    lines[car] = line;

    float offLineM = lineOffM(car, line, rearAxleM, advance.progressM, 0.0);
    readings[car] = vec4(advance.progressM, advance.coveredM, advance.shiftM, offLineM);
    runsShort[car] = lineRunsShort(build, line, advance.progressM, roadRunsOn[car] != 0u) ? 1u : 0u;
}
