#version 460
#extension GL_GOOGLE_include_directive : require

// A watch over every body (bench/WatchRuns.cs, whose arithmetic this is), one thread a body — walkers first, then cars, as
// the watch numbers them: how deep each is into anything and its run of steps deeper than the allowance; how far past its
// grant each car is and its run of steps going deeper past it; how long each walker afoot has got nowhere; and the metres
// each driven car covered. Every body's runs are kept here from step to step, and each workgroup's deepest, longest and
// furthest, each with its lowest-numbered body, and its metres left for town_watch_total.comp.

layout(local_size_x = 256) in;

layout(push_constant) uniform Figures
{
    uint walkerCount;
    uint carCount;
    float overlapAllowanceM;
    float pastAllowanceM;
    float movedM;
    float tickSeconds;
} figures;

#include "world/town/kernels/walker_table.glsl"
#include "app/devicetick/kernels/town_watch.glsl"

layout(std430, binding = 0) readonly buffer Overlap { uint overlapBits[]; };
layout(std430, binding = 1) readonly buffer Pose { vec4 pose[]; };
layout(std430, binding = 2) readonly buffer Motion { vec4 motion[]; };
layout(std430, binding = 3) readonly buffer WalkerBodies { int walkerBodies[]; };
layout(std430, binding = 4) readonly buffer CarBodies { WatchCarBody carBodies[]; };
layout(std430, binding = 5) readonly buffer Walkers { WalkerTableRow walkers[]; };
layout(std430, binding = 6) readonly buffer Cars { WatchCarRow cars[]; };
layout(std430, binding = 7) buffer StuckTicks { uint stuckTicks[]; };
layout(std430, binding = 8) buffer PastM { float pastM[]; };
layout(std430, binding = 9) buffer PastTicks { uint pastTicks[]; };
layout(std430, binding = 10) buffer StillFrom { vec2 stillFromM[]; };
layout(std430, binding = 11) buffer StillTicks { uint stillTicks[]; };
layout(std430, binding = 12) writeonly buffer Partials { WatchedRow partials[]; };

shared WatchedRow best[256];

// Nought for whatever is not above it — its sign among it, so a nought's bits are nought's.
float above(float m)
{
    return m > 0.0 ? m : 0.0;
}

WatchedRow watch(uint body)
{
    WatchedRow row = nothingWatched();
    bool walker = body < figures.walkerCount;
    uint car = body - figures.walkerCount;
    int at = walker ? walkerBodies[body] : carBodies[car].body;

    float overlapM = at >= 0 ? above(uintBitsToFloat(overlapBits[at])) : 0.0;
    uint stuck = overlapM > figures.overlapAllowanceM ? stuckTicks[body] + 1u : 0u;
    stuckTicks[body] = stuck;
    if (overlapM > 0.0)
    {
        row.deepestBits = floatBitsToUint(overlapM);
        row.deepestBody = body;
    }

    if (stuck > 0u)
    {
        row.stuckTicks = stuck;
        row.stuckBody = body;
    }

    // Going deeper and never being past: a car stopped a stride over where it was told to latches a run otherwise.
    float past = walker ? 0.0 : above(cars[car].pastM);
    bool deeper = past > figures.pastAllowanceM && past > pastM[body] + figures.pastAllowanceM;
    uint run = deeper ? pastTicks[body] + 1u : 0u;
    pastTicks[body] = run;
    pastM[body] = past;
    if (past > 0.0)
    {
        row.pastBits = floatBitsToUint(past);
        row.pastBody = body;
    }

    if (run > 0u)
    {
        row.pastTicks = run;
        row.pastTicksBody = body;
    }

    if (walker)
    {
        uint flags = walkers[body].flags;
        bool afoot = (flags & (WalkerTableWounded | WalkerTableInside)) == 0u && (flags & WalkerTableWalking) != 0u;
        vec2 atM = at >= 0 ? pose[at].xy : stillFromM[body];
        if (!afoot || length(atM - stillFromM[body]) > figures.movedM)
        {
            stillFromM[body] = atM;
            stillTicks[body] = 0u;
        }
        else
        {
            row.stillTicks = stillTicks[body] + 1u;
            stillTicks[body] = row.stillTicks;
        }
    }
    else if (cars[car].driven != 0u && at >= 0)
    {
        row.drivenM = length(motion[at].xy) * figures.tickSeconds;
    }

    return row;
}

void main()
{
    uint lane = gl_LocalInvocationID.x;
    uint body = gl_GlobalInvocationID.x;
    best[lane] = body < figures.walkerCount + figures.carCount ? watch(body) : nothingWatched();
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u)
    {
        if (lane < stride) best[lane] = better(best[lane], best[lane + stride]);
        barrier();
    }

    if (lane == 0u) partials[gl_WorkGroupID.x] = best[0];
}
