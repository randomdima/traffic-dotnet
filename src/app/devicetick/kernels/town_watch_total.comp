#version 460
#extension GL_GOOGLE_include_directive : require

// A watch over every body (town_watch.comp), the step's whole read off every workgroup's by one workgroup — the deepest,
// longest and furthest, each with its lowest-numbered body, and the metres — written where the host reads it, with what the
// watch has against each body the host noted.

layout(local_size_x = 256) in;

layout(push_constant) uniform Figures
{
    uint groups;
    uint noteCount;
    uint walkerCount;
    uint pad;
} figures;

#include "app/devicetick/kernels/town_watch.glsl"

layout(std430, binding = 0) readonly buffer Partials { WatchedRow partials[]; };
layout(std430, binding = 1) writeonly buffer Watched { WatchedRow watched; WatchNoteRow notes[]; };
layout(std430, binding = 2) readonly buffer Noted { uint noted[]; };
layout(std430, binding = 3) readonly buffer Overlap { uint overlapBits[]; };
layout(std430, binding = 4) readonly buffer WalkerBodies { int walkerBodies[]; };
layout(std430, binding = 5) readonly buffer CarBodies { WatchCarBody carBodies[]; };
layout(std430, binding = 6) readonly buffer StuckTicks { uint stuckTicks[]; };
layout(std430, binding = 7) readonly buffer PastM { float pastM[]; };
layout(std430, binding = 8) readonly buffer PastTicks { uint pastTicks[]; };

shared WatchedRow best[256];

void main()
{
    uint lane = gl_LocalInvocationID.x;
    WatchedRow row = nothingWatched();
    for (uint group = lane; group < figures.groups; group += 256u) row = better(row, partials[group]);

    best[lane] = row;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u)
    {
        if (lane < stride) best[lane] = better(best[lane], best[lane + stride]);
        barrier();
    }

    if (lane == 0u) watched = best[0];
    if (lane >= figures.noteCount) return;

    uint body = noted[lane];
    int at = body < figures.walkerCount ? walkerBodies[body] : carBodies[body - figures.walkerCount].body;
    float overlapM = at >= 0 ? uintBitsToFloat(overlapBits[at]) : 0.0;
    notes[lane] = WatchNoteRow(body, overlapM, stuckTicks[body], pastM[body], pastTicks[body]);
}
