#version 460
#extension GL_GOOGLE_include_directive : require

// A frame's walkers as the emit reads them (sprites_person.glsl's PersonRow), made current off the walker tick's own
// table, one thread a walker: one the table is known to hold as the town has it (PersonPoseFromTheDevice,
// app/devicetick/DeviceWalkerTick.HoldsTheBodyOf) takes where the bodies' step left it, which way its tick faced it, how
// far it has walked and whether it is walking over the town's copy — a claims rebuild on the device sets a walker walking
// that the town reads only when it asks for it.

layout(local_size_x = 64) in;

layout(push_constant) uniform Figures
{
    uint walkerCount;
} figures;

#include "app/render/kernels/sprites_person.glsl"
#include "world/town/kernels/walker_table.glsl"

layout(std430, binding = 0) buffer People { PersonRow people[]; };
layout(std430, binding = 1) readonly buffer Walkers { WalkerTableRow walkers[]; };

void main()
{
    uint walker = gl_GlobalInvocationID.x;
    if (walker >= figures.walkerCount || (people[walker].flags & PersonPoseFromTheDevice) == 0u) return;

    WalkerTableRow row = walkers[walker];
    people[walker].positionM = row.positionM;
    people[walker].headingRad = row.headingRad;
    people[walker].distanceWalkedM = row.distanceWalkedM;
    people[walker].flags = (people[walker].flags & ~PersonWalking) | ((row.flags & WalkerTableWalking) != 0u ? PersonWalking : 0u);
}
