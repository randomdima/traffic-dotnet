#version 460
#extension GL_GOOGLE_include_directive : require

// The emit's third pass (PER-31): every walker the write pass built aside, in roster order, put where it is drawn — at
// the head of the over run, behind every walker it is ranked after (PersonSprites.Depth). Its place is how many of the
// walkers shown rank before it: comparisons go as the square of the walkers on screen, and nothing off it is read.
//
// One workgroup a walker, its threads counting a share of the others each and adding their counts: a thread a walker
// counting them all one after another leaves a frame's couple of hundred walkers on a handful of workgroups, each a
// long chain of reads, which costs tens of µs where this costs a few.

layout(local_size_x = 64) in;

#include "app/render/kernels/sprites_buffers.glsl"

const uint Lanes = 64u;

shared uint place;

// PersonSprites.Depth, field for field: upright after lying, then its feet down the picture, then across it.
vec3 depthOf(SpriteOut walker)
{
    bool lying = (walker.sheet & ((1u << SpriteRingShift) - 1u)) >= figures.firstDownSheet;
    float feetM = lying ? walker.centreY : walker.centreY + unpackHalf2x16(walker.halfSize).y;
    return vec3(lying ? 0.0 : 1.0, feetM, walker.centreX);
}

// Two that rank alike keep their roster order, so no two walkers are ever given one place.
bool before(vec3 one, uint oneAt, vec3 other, uint otherAt)
{
    if (one.x != other.x) return one.x < other.x;
    if (one.y != other.y) return one.y < other.y;
    if (one.z != other.z) return one.z < other.z;
    return oneAt < otherAt;
}

void main()
{
    uint walker = gl_WorkGroupID.x;
    uint shown = figures.personCapacity < spritesSlotCount() ? starts[figures.personCapacity] : totals[TotalAt];
    // The whole workgroup or none of it, so both barriers are reached by all of it.
    if (walker >= shown) return;

    uint lane = gl_LocalInvocationID.x;
    if (lane == 0u) place = 0u;
    barrier();

    vec3 depth = depthOf(walkersShown[walker]);
    uint ahead = 0u;
    for (uint other = lane; other < shown; other += Lanes)
    {
        if (before(depthOf(walkersShown[other]), other, depth, walker)) ahead++;
    }

    atomicAdd(place, ahead);
    barrier();

    if (lane == 0u && place < figures.roomOver) instances[place] = walkersShown[walker];
}
