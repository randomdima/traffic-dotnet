#version 460
#extension GL_GOOGLE_include_directive : require

// The emit's first pass: how many instances each part of each unit draws this frame, one thread a unit — a walker and a
// car (its five parts) in whichever run its level is drawn in, a train's wagon, a signal head, a crossing's gear or its X
// light, a chimney's smoke — into the slot the scan turns into
// where they start. A cull and no more: nothing is built here. A car's lit lenses are kept for the second pass, which
// would otherwise read its line again.

layout(local_size_x = 64) in;

#include "app/render/kernels/sprites_buffers.glsl"

void countCar(uint car)
{
    uint run = car < frame.carCount ? spritesRunOf(cars[car]) : RunNone;
    uint counts[CarParts] = uint[](0u, 0u, 0u, 0u, 0u);
    uvec2 shown = uvec2(0u);
    if (run != RunNone)
    {
        counts[PartSmoke] = spritesPuffsShown(car);
        counts[PartTyres] = spritesTyresShown(car);
        counts[PartBody] = spritesBodyShown(car) ? 1u : 0u;
        counts[PartBeam] = spritesBeamShown(car) ? 1u : 0u;
        shown = spritesLamps(car);
        // A glow and a lens a lamp drawn.
        counts[PartLamps] = 2u * uint(bitCount(shown.x));
    }

    lampsShown[car] = shown;
    for (uint part = 0u; part < CarParts; part++)
    {
        starts[spritesCarSlot(RunOver, part, car)] = run == RunOver ? counts[part] : 0u;
        if (figures.levelled != 0u) starts[spritesCarSlot(RunAbove, part, car)] = run == RunAbove ? counts[part] : 0u;
    }
}

void main()
{
    uint unit = gl_GlobalInvocationID.x;
    if (unit < figures.personCapacity)
    {
        uint run = unit < frame.personCount && spritesPersonShown(unit) ? spritesRunOfPerson(people[unit]) : RunNone;
        starts[unit] = run == RunOver ? 1u : 0u;
        if (figures.levelled != 0u) starts[spritesAboveFrom() + unit] = run == RunAbove ? 1u : 0u;
        return;
    }

    unit -= figures.personCapacity;
    if (unit < figures.carCapacity)
    {
        countCar(unit);
        return;
    }

    unit -= figures.carCapacity;
    if (unit < figures.wagonCount)
    {
        bool shown = spritesWagonShown(unit);
        bool above = figures.bridged != 0u && spritesWagonOnABridge(unit);
        uint drawn = shown ? 1u : 0u;
        uint puffs = spritesWagonPuffsShown(unit);
        starts[spritesWagonsFrom() + unit] = !above ? drawn : 0u;
        starts[spritesWagonSmokeFrom() + unit] = !above ? puffs : 0u;
        if (figures.bridged != 0u)
        {
            starts[spritesWagonsAboveFrom() + unit] = above ? drawn : 0u;
            starts[spritesWagonSmokeAboveFrom() + unit] = above ? puffs : 0u;
        }

        return;
    }

    unit -= figures.wagonCount;
    if (unit < figures.headCount)
    {
        starts[spritesHeadsFrom() + unit] = spritesHeadShown(unit) ? 1u : 0u;
        return;
    }

    unit -= figures.headCount;
    if (unit < figures.gearCount)
    {
        uvec2 shown = spritesGearShown(unit);
        uint from = spritesGearFrom() + GearParts * unit;
        starts[from] = shown.x;
        starts[from + 1u] = shown.y;
        return;
    }

    unit -= figures.gearCount;
    if (unit < figures.lightCount)
    {
        starts[spritesLightsFrom() + unit] = spritesLightShown(unit) ? 1u : 0u;
        return;
    }

    unit -= figures.lightCount;
    if (unit >= figures.chimneyCount) return;

    starts[spritesChimneysFrom() + unit] = spritesChimneyPuffsShown(unit);
}
