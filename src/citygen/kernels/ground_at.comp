#version 460
#extension GL_GOOGLE_include_directive : require

// The ground asked at a run of points, one thread a point: what each stands on, on its level. The kernel a tyre's
// and a line's ground is asked by, and how the device's answer is held to the host's.

layout(local_size_x = 64) in;

layout(push_constant) uniform Ask
{
    uint pointCount;
    int roadFromX;
    int roadFromY;
    int roadWidth;
    int roadHeight;
    float roadPerCellM;
    float farthestReachM;
    uint slabCount;
    uint waterFrom;
    uint waterTo;
    uint shoreFrom;
    uint shoreTo;
};

#define SPLINE_ARCS groundArcs
#define RING_CELLS groundLatticeCells
#define RING_FILING groundLatticeFiling
#define RING_PIECES groundLatticePieces
#define GROUND_BINDING 2

#include "core/geometry/kernels/arc.glsl"
#include "core/geometry/kernels/ringsides.glsl"
#include "citygen/kernels/ground_tables.glsl"

layout(std430, binding = 0) readonly buffer Points { vec4 points[]; };
layout(std430, binding = 1) writeonly buffer Grounds { uint grounds[]; };

#include "core/geometry/kernels/arc_chain.glsl"
#include "core/geometry/kernels/ring_winding.glsl"
#include "citygen/kernels/ground.glsl"

void main()
{
    uint at = gl_GlobalInvocationID.x;
    if (at >= pointCount) return;

    vec4 point = points[at];
    grounds[at] = groundAt(point.xy, uint(point.z));
}
