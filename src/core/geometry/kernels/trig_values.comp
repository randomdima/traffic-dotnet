#version 460
#extension GL_GOOGLE_include_directive : require

// Each angle's sine, cosine, tangent and arctangent, and the bearing of each point, one thread an angle — trig.glsl asked
// on its own, which is how the device's answer is held to the host's.

layout(local_size_x = 64) in;

layout(push_constant) uniform Ask
{
    uint angleCount;
};

// x an angle and the point's own; y the point's other.
layout(std430, binding = 0) readonly buffer Asked { vec2 asked[]; };
layout(std430, binding = 1) writeonly buffer Values { vec4 values[]; };
layout(std430, binding = 2) writeonly buffer Bearings { float bearings[]; };

#include "trig.glsl"

void main()
{
    uint at = gl_GlobalInvocationID.x;
    if (at >= angleCount) return;

    float x = asked[at].x;
    float sine;
    float cosine;
    trigSinCos(x, sine, cosine);
    values[at] = vec4(sine, cosine, trigTan(x), trigAtan(x));
    bearings[at] = trigAtan2(asked[at].y, x);
}
