#version 460

// The second half of a scan longer than one block: every element after the first block given the scanned total of
// the blocks before its own. How many is the push constant's, or — where countAt names a slot — the figure there held
// to it (scan.comp).

layout(local_size_x = 256) in;

layout(push_constant) uniform Scan
{
    uint count;
    uint countAt;
};

const uint NoCount = 0xFFFFFFFFu;

layout(std430, binding = 0) buffer Data { uint data[]; };
layout(std430, binding = 1) readonly buffer Sums { uint sums[]; };
layout(std430, binding = 2) readonly buffer Source { uint source[]; };

void main()
{
    uint n = countAt == NoCount ? count : min(source[countAt], count);
    uint at = gl_GlobalInvocationID.x;
    if (at >= n || at < 2048) return;

    data[at] += sums[at / 2048];
}
