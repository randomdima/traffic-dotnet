#version 460

// An exclusive prefix sum of a run of counts, in place, 2 048 to a workgroup (Blelloch's up- and down-sweep in
// shared memory). Each block's total goes to sums[sumAt + block], so the same kernel scans the counts and then,
// one workgroup over those totals, the totals themselves — the second time with sumAt naming the slot the grand
// total is kept in.

layout(local_size_x = 1024) in;

layout(push_constant) uniform Scan
{
    uint count;
    uint sumAt;
};

layout(std430, binding = 0) buffer Data { uint data[]; };
layout(std430, binding = 1) buffer Sums { uint sums[]; };

shared uint running[2048];

void main()
{
    uint thread = gl_LocalInvocationID.x;
    uint first = gl_WorkGroupID.x * 2048 + 2 * thread;
    running[2 * thread] = first < count ? data[first] : 0;
    running[2 * thread + 1] = first + 1 < count ? data[first + 1] : 0;

    uint stride = 1;
    for (uint working = 1024; working > 0; working >>= 1)
    {
        barrier();
        if (thread < working)
        {
            uint left = stride * (2 * thread + 1) - 1;
            uint right = stride * (2 * thread + 2) - 1;
            running[right] += running[left];
        }

        stride <<= 1;
    }

    barrier();
    if (thread == 0)
    {
        sums[sumAt + gl_WorkGroupID.x] = running[2047];
        running[2047] = 0;
    }

    for (uint working = 1; working < 2048; working <<= 1)
    {
        stride >>= 1;
        barrier();
        if (thread < working)
        {
            uint left = stride * (2 * thread + 1) - 1;
            uint right = stride * (2 * thread + 2) - 1;
            uint carried = running[left];
            running[left] = running[right];
            running[right] += carried;
        }
    }

    barrier();
    if (first < count) data[first] = running[2 * thread];
    if (first + 1 < count) data[first + 1] = running[2 * thread + 1];
}
