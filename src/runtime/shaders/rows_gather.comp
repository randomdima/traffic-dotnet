#version 460

// The named items' rows copied out of a buffer the device keeps into the host's memory, each stamped with the gather's
// stamp, one thread an item (runtime/GatheredRows): what crosses is the rows named and nothing else. The names are a
// list the host laid or a kernel wrote, and how many there are is read off the device, so a list a kernel wrote is
// gathered in the same submit with the recording unchanged.

layout(local_size_x = 64) in;

layout(push_constant) uniform Gather
{
    uint rowWords;
    uint stamp;
    uint most;
    uint countAt;
    uint namedFrom;
} gather;

layout(std430, binding = 0) readonly buffer From { uint fromWords[]; };
layout(std430, binding = 1) writeonly buffer Into { uint intoWords[]; };
layout(std430, binding = 2) writeonly buffer Stamps { uint stamps[]; };
layout(std430, binding = 3) readonly buffer Named { uint named[]; };
layout(std430, binding = 4) readonly buffer Counts { uint counts[]; };

void main()
{
    uint at = gl_GlobalInvocationID.x;
    if (at >= min(counts[gather.countAt], gather.most)) return;

    uint item = named[gather.namedFrom + at];
    uint first = item * gather.rowWords;
    for (uint word = 0u; word < gather.rowWords; word++) intoWords[first + word] = fromWords[first + word];
    stamps[item] = gather.stamp;
}
