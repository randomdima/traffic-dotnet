<!-- A workshop tool, not the runtime: it asks OpenStreetMap for one city and writes the traced map's survey,
     and draws OSM's own lanes over a shot of it. Nothing it does runs when a map is opened. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TrafficSimulation.Tools.OsmScan</RootNamespace>
    <AssemblyName>osm-scan</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- The survey's format and OSM's lane rules are the engine's own files, compiled here as well, so what the
       scanner writes is what the engine reads by construction. -->
  <ItemGroup>
    <Compile Include="../../citygen/traced/OsmExtract.cs" Link="Shared/OsmExtract.cs" />
    <Compile Include="../../citygen/traced/OsmCarriageway.cs" Link="Shared/OsmCarriageway.cs" />
    <Compile Include="../../citygen/traced/OsmTurns.cs" Link="Shared/OsmTurns.cs" />
    <Compile Include="../../citygen/traced/TransverseMercator.cs" Link="Shared/TransverseMercator.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
  </ItemGroup>

</Project>
