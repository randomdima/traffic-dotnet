<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Expected in src/runtime/ and in the mapped-buffer writer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>TrafficSimulation</RootNamespace>
    <AssemblyName>traffic-dotnet</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Plain JIT with tiered compilation and Dynamic PGO, both on by default: the fastest steady
         state, which is the only thing this engine measures. NativeAOT is an export profile and a
         measurement of its own, never the default. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Both measured: server GC is worth nothing here and background GC costs 13 %. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Tiering promotes a method to tier 1 once it has been called enough times, but only after the
         call-counting delay has expired — and that delay restarts every time any method is called for
         the first time. It exists so that a startup finishes before the tiering machinery begins,
         which assumes a process stops meeting new methods within a few hundred milliseconds. Opening
         a map does not: it walks the generator, the geometry, the mesh and the world in sequence,
         meeting new methods the whole way, so the timer is pushed forward until the load is over and
         every stage of it runs in quick-JIT code. Odesa opens in 2844 ms with the delay and 1817 ms
         without, and the tick is unmoved either way (the town probe reads 3325.8 against 3262.6 µs,
         nothing allocated on both). Quick JIT and Dynamic PGO both stay on: turning either off is
         slower than this, at 1992 ms and 2528 ms.
         It is not a documented runtimeconfig property. It reaches the runtime through CLRConfig, the
         same path as the DOTNET_TC_CallCountingDelayMs variable, and a runtime that renamed it would
         slow the load back down in silence. The load probe is what would notice. -->
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation.CallCountingDelayMs" Value="0" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The engine's sources are src/, minus the two projects of their own that live beside them and
         the other heads' halves of the machine: a folder named web/ or android/ under src/ is another
         head's (traffic-dotnet.web.csproj, traffic-dotnet.android.csproj), and this one compiles
         neither. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);assets/**;towns/**;src/tests/**;src/tools/**;src/**/web/**;src/**/android/**;bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- The unit suite reads types that are internal because nothing outside this assembly is meant to
       call them. This is the whole of the exception. -->
  <ItemGroup>
    <InternalsVisibleTo Include="traffic-dotnet-tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <!-- 3.1.x, not 4.x: 4.0 added a licence key whose absence is two warnings on every build.
         Same decode API, and the version to revisit if a licence is ever bought. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <!-- The physics is not a package: src/world/physics/ is this project's own broad phase, narrow phase and
       contact solver. Box2D.NET is referenced by the unit suite alone, as the independent
       implementation the cast and the manifolds are checked against. -->

  <!-- The typeface, embedded so the shipped assembly has nothing to find at run time. Cut by
       src/tools/glyphsheet and committed — a workshop tool's output, never a build step. -->
  <ItemGroup>
    <EmbeddedResource Include="src/runtime/glyphs/glyphs.png" LogicalName="Glyphs/glyphs.png" />
  </ItemGroup>

  <!-- The shaders, compiled and embedded by the runtime's own file, because the handset head does it
       the same way and a second copy of it would be two answers. -->
  <Import Project="src/runtime/shaders/Shaders.targets" />

</Project>
